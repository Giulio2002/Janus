/-!
# Loop lemmas of the real-format `fmt.errorf` stub (arm64)

GENERATED by `scripts/errorf/gen_loops.py` from the templates in that script (one decimal loop per number,
one byte-copy loop per segment). Each lemma is stated for the stub `ErrorfRealCode.code` at its own
loop head and exit and takes the rest of the run as a continuation `htail`.
-/

namespace Janus.Contracts.ErrorfRealLoops

open Janus Janus.Arm64 Janus.GoABI Janus.Tactic Janus.Contracts Janus.Contracts.Toy Janus.Contracts.LiveSat Janus.Spec
  Janus.Spec.Errorf Janus.Contracts.ErrorfMem
open Janus.Contracts.AllocSat (toy A0 at0 link_at0 withCode)
open Janus.Contracts.ErrorfRealCode (code)

set_option maxRecDepth 100000

theorem dig_n1 (s : State) (h30 : (s.regs 30).toNat < 2 ^ 48) (h30' : (s.regs 30).toNat % 4 = 0) :
    ∀ (t : Nat) (R : Nat → W64) (m : Memory) (F : Flags) (endp : Nat),
      t < 2 ^ 64 → R 11 = BitVec.ofNat 64 t → R 13 = BitVec.ofNat 64 endp → R 15 = 10#64 → R 30 = s.regs 30 →
      (natBytes t).length ≤ endp → endp < 2 ^ 48 →
      m.accessible (endp - (natBytes t).length) (natBytes t).length true = true →
      ∀ Q : State → Prop,
        (∀ c : W64, ReachesRet (withCode code) (s.regs 30)
          { s with regs := setReg (setReg (setReg (setReg R 11 0#64) 13 (BitVec.ofNat 64 (endp - (natBytes t).length))) 14 0#64) 16 c,
                   flags := F, mem := putBytes m (endp - (natBytes t).length) (natBytes t), pc := 0x100048#64 } Q) →
        ReachesRet (withCode code) (s.regs 30) { s with regs := R, flags := F, mem := m, pc := 0x100030#64 } Q := by
  intro t
  induction t using Nat.strongRecOn with
  | _ t ih =>
  intro R m F endp ht h11 h13 h15 h30R hle hend hacc Q htail
  have hpos := natBytes_length_pos t
  have h1e : 1 ≤ endp := by omega
  janus_run [h11, h13, h15, h30R] until [0x100030, 0x100048]
  · -- exit: t < 10
    have ht10 : t < 10 := by omega
    have hq : t / 10 = 0 := by omega
    have := htail (BitVec.ofNat 64 t - BitVec.ofNat 64 (t / 10) * 10#64 + 48#64)
    rw [natBytes_lt ht10] at this
    simp only [List.length_singleton, putBytes_cons, putBytes_nil, hq] at this ⊢
    refine Eq.mpr (congrArg (fun st => ReachesRet (withCode code) (s.regs 30) st Q) ?_) this
    congr 1
    · have hsub : BitVec.ofNat 64 endp - 1#64 = BitVec.ofNat 64 (endp - 1) := by
        apply BitVec.eq_of_toNat_eq
        simp only [BitVec.toNat_sub, BitVec.toNat_ofNat]
        omega
      rw [hsub]
    · have : (0#64 * 10#64).toNat = 0 := by decide
      rw [this]
      congr 1
      omega
  · have h10 : 10 ≤ t := by omega
    have hq : t / 10 < t := by omega
    have hlen : (natBytes t).length = (natBytes (t / 10)).length + 1 := by
      rw [natBytes_ge h10]; simp
    have hpos' := natBytes_length_pos (t / 10)
    have hdig : (18446744073709551616 - (BitVec.ofNat 64 (t / 10) * 10#64).toNat + t + 48) % 18446744073709551616
        = 48 + t % 10 := by
      have : (BitVec.ofNat 64 (t / 10) * 10#64).toNat = t / 10 * 10 := by
        simp only [BitVec.toNat_mul, BitVec.toNat_ofNat]
        rw [Nat.mod_eq_of_lt (by omega : t / 10 < 2 ^ 64), Nat.mod_eq_of_lt (by omega : t / 10 * 10 < 2 ^ 64)]
      rw [this]; omega
    have hsub : BitVec.ofNat 64 endp - 1#64 = BitVec.ofNat 64 (endp - 1) := by
      apply BitVec.eq_of_toNat_eq
      simp only [BitVec.toNat_sub, BitVec.toNat_ofNat]
      omega
    rw [hdig, hsub]
    refine ih (t / 10) hq _ _ _ (endp - 1) (by omega) (by simp [setReg]) (by simp [setReg]) (by simp [setReg, h15]) (by simp [setReg, h30R])
      (by omega) (by omega) ?_ Q ?_
    · simp only [Janus.Arm64.Memory.accessible_writeLE]
      exact Memory.accessible_mono _ hacc (by omega) (by omega)
    · intro c
      have := htail c
      refine Eq.mpr (congrArg (fun st => ReachesRet (withCode code) (s.regs 30) st Q) ?_) this
      congr 1
      · have e : endp - 1 - (natBytes (t / 10)).length = endp - (natBytes t).length := by omega
        rw [e]
        funext i
        simp only [setReg]
        split <;> simp_all
      · rw [putBytes_writeLE_comm _ _ _ _ _ (Or.inr (by omega))]
        have e : endp - 1 - (natBytes (t / 10)).length = endp - (natBytes t).length := by omega
        rw [e, natBytes_ge h10, putBytes_snoc]
        simp only [List.length_append, List.length_singleton]
        have e2 : endp - ((natBytes (t / 10)).length + 1) + (natBytes (t / 10)).length = endp - 1 := by omega
        rw [e2]

