    exact e'

theorem rguard64 : StackRoom64 rstate64 4096 5 := by
  obtain ⟨⟨a, b, c⟩, d⟩ := wguard64 [rFP, 26, rSP, 3, 3] 5 (by omega)
  refine ⟨⟨a, ?_, ?_⟩, d⟩
