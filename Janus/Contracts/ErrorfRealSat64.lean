theorem rcall64 : CallOK64 rstate64 4096 5 := by
  obtain ⟨a, b, c, d, e⟩ := wcallOK64 [rFP, 26, rSP, 3, 3] 5 (by omega)
  have e4 : (rstate64.regs 4).toNat = LiveSat.wsp := LiveSat.wspn
