import Janus.Contracts.Alloc

/-!
# The size-specialised allocator (`GOEXPERIMENT=sizespecializedmalloc`, arm64)

With the experiment on, the compiler replaces `new(T)` (and `&T{…}`) of a type of at most 512
bytes (`heapBitsInSpan`) by a direct call of an entry point specialised to the size class of `T`
(`cmd/compile/internal/ssagen.specializedMallocSym`, `runtime/malloc_generated.go`, generated by
`runtime/_mkmalloc`), with the arguments of `mallocgc` (`size`, `typ`, `needzero = true`):

| `T` | entry point | condition (`SCArgs`) |
| --- | --- | --- |
| pointer-free, `size < 16` | `mallocgcTinySize<size>` | `TinyArgs n` |
| pointer-free, `16 ≤ size ≤ 512` | `mallocgcSmallNoScanSC<class>` | `NoScanArgs n` |
| with pointers, `size ≤ 512` | `mallocgcSmallScanNoHeaderSC<class>` | `ScanArgs n` |

Each is `mallocgc` with the size class fixed, so each contract is `MallocgcContract`'s
(`Janus/Contracts/Alloc.lean`, with the readiness predicate `H : RtReady` of round 9) restricted
to the calls the compiler emits for that entry point: the same precondition plus the size class,
the same postcondition (a fresh object, `mallocgcObj`). The condition is what makes the call one
of the entry point's: `classSize size` is the class's size (`sizeClasses`, the runtime's table
`SizeToSizeClass8` read as "the smallest class holding `size`").
-/

namespace Janus.Contracts

open Janus Janus.Arm64 Janus.Tactic Janus.Spec

/-- The size of size class `n` (`sizeClasses` lists classes 1, 2, …). -/
def classSizeOf (n : Nat) : Nat := sizeClasses.getD (n - 1) 0

/-- `mallocgcSmallNoScanSC<n>(size, typ, true)`: a pointer-free type of `16 ≤ size ≤ 512` bytes
in class `n`. -/
def NoScanArgs (n : Nat) (m : Memory) (size typ : Nat) : Prop :=
  16 ≤ size ∧ size ≤ 512 ∧ classSize size = classSizeOf n ∧ typ ≠ 0 ∧ typNoscan m typ = true

/-- `mallocgcSmallScanNoHeaderSC<n>(size, typ, true)`: a type with pointers of at most 512 bytes
in class `n`. -/
def ScanArgs (n : Nat) (m : Memory) (size typ : Nat) : Prop :=
  0 < size ∧ size ≤ 512 ∧ classSize size = classSizeOf n ∧ typ ≠ 0 ∧ typNoscan m typ = false

/-- `mallocgcTinySize<n>(n, typ, true)`: a pointer-free type of `n < 16` bytes. -/
def TinyArgs (n : Nat) (m : Memory) (size typ : Nat) : Prop :=
  0 < n ∧ n < 16 ∧ size = n ∧ typ ≠ 0 ∧ typNoscan m typ = true

/-- The common shape: `mallocgc`'s contract for the calls `args` admits. -/
def MallocgcSCPre (args : Memory → Nat → Nat → Prop) (rt : List (Nat × Nat)) (stack : Nat)
    (H : RtReady) (s : State) : Prop :=
  (MallocgcPre stack s ∧ Ready H rt [(s.regs 0).toNat, (s.regs 1).toNat, (s.regs 2).toNat] s) ∧
    args s.mem (s.regs 0).toNat (s.regs 1).toNat

/-- **`runtime.mallocgcSmallNoScanSC<n>`** (arm64). -/
def MallocgcSmallNoScanSCContract (n : Nat) (p : Program) (addr : Nat) (rt : List (Nat × Nat))
    (stack : Nat) (H : RtReady) : Prop :=
  Summary p addr (MallocgcSCPre (NoScanArgs n) rt stack H)
    (fun s s' => AllocRet rt stack 3 (fun ptr => [ptr]) s s' (mallocgcObj rt s))

/-- **`runtime.mallocgcSmallScanNoHeaderSC<n>`** (arm64). -/
def MallocgcSmallScanNoHeaderSCContract (n : Nat) (p : Program) (addr : Nat) (rt : List (Nat × Nat))
    (stack : Nat) (H : RtReady) : Prop :=
  Summary p addr (MallocgcSCPre (ScanArgs n) rt stack H)
    (fun s s' => AllocRet rt stack 3 (fun ptr => [ptr]) s s' (mallocgcObj rt s))

/-- **`runtime.mallocgcTinySize<n>`** (arm64). -/
def MallocgcTinySizeContract (n : Nat) (p : Program) (addr : Nat) (rt : List (Nat × Nat))
    (stack : Nat) (H : RtReady) : Prop :=
  Summary p addr (MallocgcSCPre (TinyArgs n) rt stack H)
    (fun s s' => AllocRet rt stack 3 (fun ptr => [ptr]) s s' (mallocgcObj rt s))

/-- Every specialised entry point's contract follows from `mallocgc`'s for the same code: a
specialised entry point that behaves as `mallocgc` meets it. -/
theorem MallocgcContract.smallNoScanSC {n : Nat} {p : Program} {addr : Nat} {rt : List (Nat × Nat)}
    {stack : Nat} {H : RtReady} (h : MallocgcContract p addr rt stack H) :
    MallocgcSmallNoScanSCContract n p addr rt stack H :=
  Summary.mono h (fun _ h => h.1) fun _ _ hp ⟨ptr, j, f, v, m, ex, ep, h1, h2, h3⟩ =>
    ⟨ptr, j, f, v, m, ex, ep, h1, h2, h3 (by have := hp.2.1; omega)⟩

theorem MallocgcContract.smallScanNoHeaderSC {n : Nat} {p : Program} {addr : Nat}
    {rt : List (Nat × Nat)} {stack : Nat} {H : RtReady} (h : MallocgcContract p addr rt stack H) :
    MallocgcSmallScanNoHeaderSCContract n p addr rt stack H :=
  Summary.mono h (fun _ h => h.1) fun _ _ hp ⟨ptr, j, f, v, m, ex, ep, h1, h2, h3⟩ =>
    ⟨ptr, j, f, v, m, ex, ep, h1, h2, h3 hp.2.1⟩

theorem MallocgcContract.tinySize {n : Nat} {p : Program} {addr : Nat} {rt : List (Nat × Nat)}
    {stack : Nat} {H : RtReady} (h : MallocgcContract p addr rt stack H) :
    MallocgcTinySizeContract n p addr rt stack H :=
  Summary.mono h (fun _ h => h.1) fun _ _ hp ⟨ptr, j, f, v, m, ex, ep, h1, h2, h3⟩ =>
    ⟨ptr, j, f, v, m, ex, ep, h1, h2, h3 (by obtain ⟨h0, -, hs, -⟩ := hp.2; omega)⟩

end Janus.Contracts
