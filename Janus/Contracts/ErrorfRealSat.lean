import Janus.Contracts.ErrorfSat
import Janus.Contracts.ErrorfRealLoops
import Janus.Contracts.ErrorfRealFmt

/-!
# The `fmt.errorf` live contract is satisfiable for the real format (arm64)

`ErrorfLive` for the format `"%w: have %d, want %d bytes"` of the `uint256` library, with a message of
any length (up to `B`) and any `int` operands: a stub (generated by `scripts/errorf/gen_arm64.py`) that
converts the two numbers to decimal into stack scratch (one do-while loop each), allocates the 32-byte
`wrapError` and the message block from the toy bump pointer, copies the errorString's text and the two
decimal strings into it (byte loops) and stores the literals.
-/

namespace Janus.Contracts.ErrorfRealSat

open Janus Janus.Arm64 Janus.GoABI Janus.Tactic Janus.Spec Janus.Spec.Errorf Janus.Contracts
  Janus.Contracts.Errorf Janus.Contracts.Toy Janus.Contracts.LiveSat Janus.Contracts.ErrorfMem
  Janus.Contracts.ErrorfRealFmt Janus.Contracts.ErrorfRealLoops
open Janus.Contracts.AllocSat (toy A0 at0 link_at0 withCode)
open Janus.Contracts.ErrorfRealCode (code)
open Janus.Contracts.ErrorfSat (tErr iErr tInt iWrap)

set_option maxRecDepth 100000
set_option maxHeartbeats 0

theorem real_impl (ok : Nat → List Nat → Prop) :
    ErrorfLive (toy.link (at0 code)) A0 4096 (toyR tys0 ok) tErr iErr tInt iWrap 26 fmtNum 4294967296 := by
  rw [link_at0]
  intro L b s hpc ⟨⟨h30a, h30b, hsp16, hst1, hst2, hst3, hacc⟩, hguard, hargs, hreads, hsafe, hok, hinv, hcost, hLs, hWs⟩
  obtain ⟨hFl, hFm, hsome, hsl, hsc, hF, hSl, hT0, hD0, hE, hTxt, hints, hlen, hB⟩ := hargs
  have hfmt : strBytes s.mem (s.regs 0).toNat 26 = fmtList := fmt_strBytes _ _ hFm
  have hsegs : segsOf s.mem (s.regs 0).toNat (s.regs 1).toNat = [Seg.ch 58, Seg.ch 32, Seg.ch 104, Seg.ch 97, Seg.ch 118, Seg.ch 101, Seg.ch 32, Seg.dec, Seg.ch 44,
      Seg.ch 32, Seg.ch 119, Seg.ch 97, Seg.ch 110, Seg.ch 116, Seg.ch 32, Seg.dec, Seg.ch 32, Seg.ch 98,
      Seg.ch 121, Seg.ch 116, Seg.ch 101, Seg.ch 115] := by
    unfold segsOf; rw [hFl, hfmt, fmt_segs]; rfl
  have hn : nDec (segsOf s.mem (s.regs 0).toNat (s.regs 1).toNat) = 2 := by rw [hsegs]; decide
  rw [hn] at hsl hints
  obtain ⟨hD1T, hD1N, hD1R⟩ := hints 0 (by omega)
  obtain ⟨hD2T, hD2N, hD2R⟩ := hints 1 (by omega)
  have hsl3 : (s.regs 3).toNat = 3 := by omega
  rw [hsl3] at hSl
  have hS48 : s.mem.accessible (s.regs 2).toNat 48 false = true := hSl.2 (by omega)
  have hS48' : (s.regs 2).toNat + 48 ≤ 2 ^ 48 := by have := hSl.1; omega
  simp only [operandD, Nat.mul_zero, Nat.add_zero, Nat.mul_one] at hE hTxt hD0
  have hE16 : s.mem.accessible (s.mem.readLE ((s.regs 2).toNat + 8) 8) 16 false = true := hE.2 (by omega)
  have hE16' : s.mem.readLE ((s.regs 2).toNat + 8) 8 + 16 ≤ 2 ^ 48 := hE.1
  have hQ1 : s.mem.accessible (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8 false = true := by
    have := hD1R.2 (by omega); simpa [operandD] using this
  have hQ1' : s.mem.readLE ((s.regs 2).toNat + 24) 8 + 8 ≤ 2 ^ 48 := by
    have := hD1R.1; simpa [operandD] using this
  have hQ2 : s.mem.accessible (s.mem.readLE ((s.regs 2).toNat + 40) 8) 8 false = true := by
    have := hD2R.2 (by omega); simpa [operandD] using this
  have hQ2' : s.mem.readLE ((s.regs 2).toNat + 40) 8 + 8 ≤ 2 ^ 48 := by
    have := hD2R.1; simpa [operandD] using this
  have hscr : s.mem.accessible (s.sp.toNat - 4096) (4096 + 8 + 8 * 5) true = true := hacc
  have hq1 : s.mem.readLE ((s.regs 2).toNat + 24) 8 < 2 ^ 64 := by
    have := Memory.readLE_lt s.mem ((s.regs 2).toNat + 24) 8; simpa using this
  have hv1 : s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8 < 2 ^ 64 := by
    have := Memory.readLE_lt s.mem (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8; simpa using this
  have hv2 : s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 40) 8) 8 < 2 ^ 64 := by
    have := Memory.readLE_lt s.mem (s.mem.readLE ((s.regs 2).toNat + 40) 8) 8; simpa using this
  have hlen1 := natBytes_length_le (toSigned (s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8)).natAbs 19 (by omega)
    (by have := natAbs_lt _ hv1; omega)
  have hlenp1 := natBytes_length_pos (toSigned (s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8)).natAbs
  janus_run until [0x100030]
  refine dig_n1 s h30b h30a (toSigned (s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8)).natAbs _ _ _
    (s.sp.toNat - 16) (by have := natAbs_lt _ hv1; omega) ?_ ?_ (by simp [setReg]) (by simp [setReg])
    (by omega) (by omega) ?_ _ ?_
  · simp only [setReg, if_true]; exact abs_bv _ hv1
  · simp only [setReg]
    rw [if_neg (by decide)]
    exact bv_sub_lit _ 16 (by omega) (by omega)
  · exact Memory.accessible_mono _ hscr (by omega) (by omega)
  · intro c
    generalize hm1 : putBytes s.mem (s.sp.toNat - 16 - (natBytes (toSigned (s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8)).natAbs).length)
      (natBytes (toSigned (s.mem.readLE (s.mem.readLE ((s.regs 2).toNat + 24) 8) 8)).natAbs) = m1
    have hf1 : MemFrame s.mem m1 [(s.sp.toNat - 4096, s.sp.toNat - 8)] := by
      rw [← hm1]
      exact putBytes_frame _ _ _ (Or.inr ⟨(s.sp.toNat - 4096, s.sp.toNat - 8), by simp, by omega, by omega⟩)
    janus_run until [0x100078]
    trace_state
    sorry

end Janus.Contracts.ErrorfRealSat
