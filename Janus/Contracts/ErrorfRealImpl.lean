theorem rsW_subE (tys : Tys) (sp0 p A : Nat) (hp : 268435456 ≤ p) (hpA : p + A ≤ 536870912) (hsp : 4096 ≤ sp0) :
    ∀ a n, Outside a n (errRt tys ++ [(sp0 - 4096, sp0 - 8), (sp0 + 8, sp0 + 8 + 8 * 5)]) →
      Outside a n [(sp0 - 4096, sp0 - 8), (4194304, 4194312), (p, p + A)] := by
  intro a n h
  simp only [outside_append] at h
  obtain ⟨hrt', hwin'⟩ := h
  simp only [errRt, toyRt, outside_cons, outside_nil, outside_append, List.map, and_true, HEAP, HEND, HSIZE, BUMP, WBUF,
    CELL] at hrt'
  simp only [outside_cons, outside_nil, and_true] at hwin' ⊢
  refine ⟨by omega, by omega, by omega⟩

