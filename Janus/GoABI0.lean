import Janus.GoABI
import Janus.Tactic.Basic

/-!
# Go ABI0 on arm64: hand-written assembly, and the ABI wrappers

Source of truth: `$GOROOT/src/cmd/compile/abi-internal.md` ("ABI0" and "Function call
wrappers") and `$GOROOT/doc/asm.html` ("Architecture-specific details: ARM64"), checked against
Go 1.26.0 and the code it emits (`examples/asm`).

ABI0 is the stack-based calling convention of Go assembly: every `TEXT ·f(SB)` written in a
`.s` file is ABI0 and the linker names it `f.abi0` (the `.abi0` symbol suffix).

| | ABI0 (assembly) | ABIInternal (Go, `Janus.GoABI`) |
| --- | --- | --- |
| arguments | the caller's frame: word `i` at `8+8i(RSP)` (`x+0(FP)` is `8(RSP)` at entry) | `R0`–`R15` |
| results | the caller's frame, after the arguments (pointer-aligned) | `R0`–`R15` |
| `R0`–`R27`, flags, `V0`–`V31` | caller-saved (scratch) | scratch |
| `R28` (`g`) | reserved: the assembler treats it as `g`; preserved | preserved |
| `R29` (frame pointer) | preserved (the assembler saves and reloads it in a frame's prologue/epilogue) | preserved |
| `R18` | platform register, never used | never used |
| `RSP` | preserved, 16-byte aligned | same |
| `R30` | return address | same |

So on arm64 the obligations on return are those of ABIInternal (`ABIReturn0` is
`GoABI.ABIReturn`); only the place of the arguments and results differs. `g` stays in `R28`
across an ABI0 call: unlike amd64 (`Janus.Amd64.GoABI0`), neither wrapper direction reloads it.

## The arguments frame

At the entry of an ABI0 function `0(RSP)` is the caller's own saved-LR slot and the arguments
start at `8(RSP)`, laid out as the fields of a Go struct; the results follow, starting at the
next pointer-aligned offset. Janus states an ABI0 frame as a list of **64-bit words**: word `i`
is the 8 bytes at `RSP + 8 + 8i`. Every argument and result of 8 bytes (integers, pointers,
`uintptr`) is one word; a slice header is three, a string two; smaller fields that share a word
are packed into it little-endian, as in the struct layout. `args` are the argument words,
`nres` the number of result words after them; the callee may write the whole frame
(`FrameOK`: `8 * (args.length + nres)` writable bytes).

## The ABI wrappers (`<autogenerated>`)

The compiler emits a wrapper whenever a function is used with the ABI it was not defined in:

* **ABIInternal → ABI0** (`f`, the Go-callable name of an assembly function `f.abi0`, used as a
  func value or from another ABI): pushes a frame, stores the register arguments into the
  outgoing argument area at `8(RSP)`, `BL f.abi0`, loads the results from the frame into
  `R0`…, pops and returns. Calls from Go code that know the callee is assembly (the same
  package, or through export data) are **direct ABI0 calls** of `f.abi0` instead, with the same
  store / `BL` / load sequence inlined in the caller.
* **ABI0 → ABIInternal** (`g.abi0`, for a Go function `g` called from assembly): pushes a
  frame, loads the arguments from its caller's frame into `R0`…, `BL g`, stores `R0`… into the
  caller's result words and returns.

All of this is ordinary machine code that Janus extracts and executes; nothing about a wrapper
or a direct call is assumed. A callee is composed at a call site through its `Summary` (or
`Summary0`, a `Summary` that includes the ABI0 return obligations) with `janus_run calls [h]`,
exactly as for ABIInternal callees; `Ensures0` is the standalone contract of an ABI0 function,
and `Ensures0.of_summary` derives it from a summary. See docs/ABI0.md.
-/

namespace Janus

open Arm64 GoABI Tactic

namespace GoABI0

/-! ## The frame -/

/-- Offset of argument word 0 from `RSP` at the entry of an ABI0 function (`x+0(FP)`). -/
def frameOffset : Nat := 8

/-- The byte address of frame word `i` relative to the entry stack pointer `sp`. -/
def frameAddr (sp : W64) (i : Nat) : Nat := sp.toNat + frameOffset + 8 * i

/-- Frame word `i` of memory `m`, for the entry stack pointer `sp`. -/
def frameWord (m : Memory) (sp : W64) (i : Nat) : W64 :=
  BitVec.ofNat 64 (m.readLE (frameAddr sp i) 8)

/-- The argument words `args` are in the frame of `s`: word `i` at `RSP + 8 + 8i`. -/
def FrameArgs (s : State) (args : List W64) : Prop :=
  ∀ i (h : i < args.length), s.mem.readLE (s.sp.toNat + 8 + 8 * i) 8 = args[i].toNat

/-- The `n`-word frame above the return slot is writable and below `2^48` (the caller owns it:
arguments, results, and nothing else of its own frame). -/
def FrameOK (s : State) (n : Nat) : Prop :=
  s.sp.toNat + 8 + 8 * n ≤ 2 ^ 48 ∧ s.mem.accessible (s.sp.toNat + 8) (8 * n) true = true

/-- `s` is a state in which the ABI0 function at `entry` has just been called (`BL`) with
argument words `args` in the caller's frame and room for `nres` result words after them,
returning to `p.exitAddr`, with `RSP` 16-byte aligned. Everything else (every register but `X30`, the flags, the SIMD&FP
registers, the rest of memory) is arbitrary: ABI0 passes nothing in registers. Specifications use
it with `p.withExit ret` for a universally quantified admissible `ret` (`GoABI.RetAddr`). -/
structure CallSetup0 (p : Program) (entry : Nat) (args : List W64) (nres : Nat) (s : State) :
    Prop where
  pc : s.pc = BitVec.ofNat 64 entry
  lr : s.regs regLR = BitVec.ofNat 64 p.exitAddr
  argWords : FrameArgs s args
  frame : FrameOK s (args.length + nres)
  /-- `RSP` is 16-byte aligned at every call (the Go toolchain keeps it so; Linux faults an
  `SP`-relative access through a misaligned `SP`). -/
  spAligned : s.sp.toNat % 16 = 0

/-- What an ABI0 function restores on return: `RSP`, `g` (`R28`), the frame pointer (`R29`) and
the platform register (`R18`) — the same as ABIInternal on arm64. -/
abbrev ABIReturn0 := GoABI.ABIReturn

/-- `k` frame words of memory `m` starting at byte address `base`. -/
def wordsAt (m : Memory) (base : Nat) : Nat → List W64
  | 0 => []
  | k + 1 => BitVec.ofNat 64 (m.readLE base 8) :: wordsAt m (base + 8) k

/-- The `nres` result words of an ABI0 call with `nargs` argument words, in the memory of the
return state `s₁`, at the frame of the call state `s₀`. -/
def results0 (s₀ s₁ : State) (nargs nres : Nat) : List W64 :=
  wordsAt s₁.mem (s₀.sp.toNat + 8 + 8 * nargs) nres

/-! ## Specifications -/

/-- ABI0 function contract: for **every** admissible return address `ret` and **every** ABI0 call
state with these argument words (and `nres` result words of frame) satisfying `pre`, the call
returns to `ret` after finitely many steps (never faulting or panicking), restores what ABI0
requires (`ABIReturn0`), and satisfies `post s₀ s₁`. -/
def Ensures0 (p : Program) (entry : Nat) (args : List W64) (nres : Nat) (pre : State → Prop)
    (post : State → State → Prop) : Prop :=
  ∀ ret, RetAddr p ret → ∀ s, CallSetup0 (p.withExit ret) entry args nres s → pre s →
    Returns (p.withExit ret) s (fun s' => ABIReturn0 s s' ∧ post s s')

/-- `Ensures0` stated on the result words of the frame. -/
def EnsuresResults0 (p : Program) (entry : Nat) (args : List W64) (nres : Nat)
    (pre : State → Prop) (post : List W64 → Prop) : Prop :=
  Ensures0 p entry args nres pre (fun s s' => post (results0 s s' args.length nres))

/-- The general registers after an ABI0 call: `R18`, `R28` (`g`) and `R29` (frame pointer) keep
their values from `old`; every other register is the unspecified `junk` (ABI0 passes nothing
back in registers and every other register is caller-saved). -/
def regs0 (old junk : Nat → W64) : Nat → W64 :=
  fun i => if i = regPlatform ∨ i = regG ∨ i = regFP then old i else junk i

/-- The state an ABI0 call from `s` returns in: registers by `regs0`, `pc = X30`, flags, SIMD&FP
registers, `FPSR` (sticky exception flags) and memory as given; `SP`, `FPCR`, `TPIDR_EL0` and
`DCZID_EL0` unchanged. -/
def retState0 (s : State) (junk : Nat → W64) (f : Flags) (v : Nat → BitVec 128) (fpsr : BitVec 32)
    (m : Memory) : State :=
  { s with regs := regs0 s.regs junk, pc := s.regs regLR, flags := f, vregs := v, fpsr := fpsr,
           mem := m }

/-- The shape of an ABI0 return from `s`: `s'` is `retState0 s …` for some unspecified
registers, flags, SIMD&FP registers and `FPSR`, and memory `m` with `Q m`. Reducible, so that the
symbolic executor splits it at a call site (substituting `s'`). -/
@[reducible] def Ret0 (s s' : State) (Q : Memory → Prop) : Prop :=
  ∃ (junk : Nat → W64) (f : Flags) (v : Nat → BitVec 128) (fpsr : BitVec 32) (m : Memory),
    s' = retState0 s junk f v fpsr m ∧ Q m

/-- An ABI0 callee summary: a `Summary` (from any state at `entry` satisfying `pre`, ordinary
steps reach the return address `X30`) whose return state has the ABI0 shape `Ret0` (only `R18`,
`g`, `FP`, `SP` and the constant system registers kept; every other register unspecified) and
memory satisfying `Q s`. ABI0 functions return their results in memory, so `Q` says everything
the caller may use. `janus_run calls [h]` uses it at the `BL` of a direct ABI0 call or of a
wrapper. -/
def Summary0 (p : Program) (entry : Nat) (pre : State → Prop) (Q : State → Memory → Prop) :
    Prop :=
  Summary p entry pre (fun s s' => Ret0 s s' (Q s))

/-! ## Lemmas -/

section Lemmas

variable {p : Program} {s s' : State} {entry : Nat} {args : List W64} {nres : Nat}

@[simp] theorem wordsAt_zero (m : Memory) (base : Nat) : wordsAt m base 0 = [] := rfl

theorem wordsAt_succ (m : Memory) (base k : Nat) :
    wordsAt m base (k + 1) = BitVec.ofNat 64 (m.readLE base 8) :: wordsAt m (base + 8) k := rfl

@[simp] theorem wordsAt_length (m : Memory) (base k : Nat) : (wordsAt m base k).length = k := by
  induction k generalizing base with
  | zero => rfl
  | succ k ih => simp [wordsAt_succ, ih]

theorem wordsAt_getElem (m : Memory) (base k j : Nat) (h : j < (wordsAt m base k).length) :
    (wordsAt m base k)[j] = BitVec.ofNat 64 (m.readLE (base + 8 * j) 8) := by
  induction k generalizing base j with
  | zero => simp at h
  | succ k ih =>
    cases j with
    | zero => simp [wordsAt_succ]
    | succ j =>
      simp only [wordsAt_succ, List.getElem_cons_succ]
      rw [ih (base + 8) j (by simp at h ⊢; omega),
        show base + 8 + 8 * j = base + 8 * (j + 1) by omega]

/-- Result word `j` is the frame word `nargs + j` of the call state's stack pointer. -/
theorem results0_getElem (s₀ s₁ : State) (nargs nres j : Nat)
    (h : j < (results0 s₀ s₁ nargs nres).length) :
    (results0 s₀ s₁ nargs nres)[j] = frameWord s₁.mem s₀.sp (nargs + j) := by
  simp only [results0] at h ⊢
  rw [wordsAt_getElem _ _ _ _ h]
  simp only [frameWord, frameAddr, frameOffset]
  rw [show s₀.sp.toNat + 8 + 8 * nargs + 8 * j = s₀.sp.toNat + 8 + 8 * (nargs + j) by omega]

theorem results0_one (s₀ s₁ : State) (nargs : Nat) :
    results0 s₀ s₁ nargs 1 = [BitVec.ofNat 64 (s₁.mem.readLE (s₀.sp.toNat + 8 + 8 * nargs) 8)] :=
  rfl

theorem CallSetup0.arg (h : CallSetup0 p entry args nres s) {i : Nat} (hi : i < args.length) :
    s.mem.readLE (s.sp.toNat + 8 + 8 * i) 8 = args[i].toNat := h.argWords i hi

theorem CallSetup0.frameWord_eq (h : CallSetup0 p entry args nres s) {i : Nat}
    (hi : i < args.length) : frameWord s.mem s.sp i = args[i] := by
  simp only [frameWord, frameAddr, frameOffset, h.arg hi, BitVec.ofNat_toNat, BitVec.setWidth_eq]

theorem CallSetup0.pc_toNat (h : CallSetup0 p entry args nres s) (he : entry < 2 ^ 64) :
    s.pc.toNat = entry := by
  rw [h.pc, BitVec.toNat_ofNat, Nat.mod_eq_of_lt he]

/-- The frame of an ABI0 call does not wrap and is writable. -/
theorem CallSetup0.frame_accessible (h : CallSetup0 p entry args nres s) :
    s.mem.accessible (s.sp.toNat + 8) (8 * (args.length + nres)) true = true := h.frame.2

theorem CallSetup0.frame_bound (h : CallSetup0 p entry args nres s) :
    s.sp.toNat + 8 + 8 * (args.length + nres) ≤ 2 ^ 48 := h.frame.1

@[janus_exec, janus_post] theorem regs0_apply (old junk : Nat → W64) (i : Nat) :
    regs0 old junk i = if i = 18 ∨ i = 28 ∨ i = 29 then old i else junk i := rfl

attribute [janus_exec, janus_post] retState0

/-- An ABI0 return state restores what `ABIReturn0` requires. -/
theorem ABIReturn0.of_ret0 {s s' : State} {Q : Memory → Prop} (h : Ret0 s s' Q) :
    ABIReturn0 s s' := by
  obtain ⟨junk, f, v, fpsr, m, rfl, -⟩ := h
  exact ⟨rfl, by simp [retState0, regs0, regG, regPlatform, regFP],
    by simp [retState0, regs0, regG, regPlatform, regFP],
    by simp [retState0, regs0, regG, regPlatform, regFP]⟩

/-- `Ret0` as equations about the return state (how a summary's postcondition is proved: the
final state of the callee's symbolic run is a concrete state term). -/
@[janus_post] theorem ret0_iff (s s' : State) (Q : Memory → Prop) :
    Ret0 s s' Q ↔ s'.sp = s.sp ∧ s'.pc = s.regs regLR ∧ s'.regs 18 = s.regs 18 ∧
      s'.regs 28 = s.regs 28 ∧ s'.regs 29 = s.regs 29 ∧ s'.fpcr = s.fpcr ∧ s'.tpidr = s.tpidr ∧
      s'.dczid = s.dczid ∧ Q s'.mem := by
  constructor
  · rintro ⟨junk, f, v, fpsr, m, rfl, hq⟩
    simp [retState0, regs0, regG, regPlatform, regFP, hq]
  · rintro ⟨h1, h2, h3, h4, h5, h6, h7, h8, hq⟩
    refine ⟨s'.regs, s'.flags, s'.vregs, s'.fpsr, s'.mem, ?_, hq⟩
    have hr : regs0 s.regs s'.regs = s'.regs := by
      funext i
      simp only [regs0, regPlatform, regG, regFP]
      split
      · rename_i hi
        rcases hi with rfl | rfl | rfl <;> simp_all
      · rfl
    cases s'
    simp only [retState0, hr] at *
    subst_vars
    rfl

/-- The memory of an ABI0 return state satisfies `Q`. -/
theorem Ret0.mem {s s' : State} {Q : Memory → Prop} (h : Ret0 s s' Q) : Q s'.mem := by
  obtain ⟨junk, f, v, fpsr, m, rfl, hq⟩ := h
  exact hq

theorem Ensures0.returns {pre : State → Prop} {post : State → State → Prop} {ret : Nat}
    (h : Ensures0 p entry args nres pre post) (hret : RetAddr p ret)
    (hs : CallSetup0 (p.withExit ret) entry args nres s) (hpre : pre s) :
    Returns (p.withExit ret) s (fun s' => ABIReturn0 s s' ∧ post s s') := h ret hret s hs hpre

theorem Ensures0.neverPanics {pre : State → Prop} {post : State → State → Prop} {ret : Nat}
    (h : Ensures0 p entry args nres pre post) (hret : RetAddr p ret)
    (hs : CallSetup0 (p.withExit ret) entry args nres s) (hpre : pre s) :
    NeverPanics (p.withExit ret) s := (h ret hret s hs hpre).neverPanics

theorem Ensures0.mono {pre pre' : State → Prop} {post post' : State → State → Prop}
    (h : Ensures0 p entry args nres pre post) (hpre : ∀ s, pre' s → pre s)
    (hpost : ∀ s s', pre' s → post s s' → post' s s') : Ensures0 p entry args nres pre' post' :=
  fun ret hret s hs hp => (h ret hret s hs (hpre s hp)).mono fun _ ⟨ha, hq⟩ => ⟨ha, hpost _ _ hp hq⟩

/-- A callee `Summary` of an ABI0 function (precondition `spre`, implied by every ABI0 call
state satisfying `pre`) is an `Ensures0` when its postcondition implies `ABIReturn0`. This is
how a summary proved once for use at call sites (direct ABI0 calls, wrappers) also gives the
function's standalone contract. -/
theorem Ensures0.of_summary {pre spre : State → Prop} {post : State → State → Prop}
    {post' : State → State → Prop} (hsum : Summary p entry spre post')
    (hpre : ∀ ret s, RetAddr p ret → CallSetup0 (p.withExit ret) entry args nres s → pre s →
      spre s)
    (hpost : ∀ ret s s', RetAddr p ret → CallSetup0 (p.withExit ret) entry args nres s → pre s →
      post' s s' → ABIReturn0 s s' ∧ post s s') :
    Ensures0 p entry args nres pre post := by
  intro ret hret s hs hp
  obtain ⟨k, s', hst, hr, hq⟩ := hsum s hs.pc (hpre ret s hret hs hp)
  have hst' := hst.withExit hret.fetch_none
  refine returns_of_steps hst' ?_ (hpost ret s s' hret hs hp hq)
  rw [hr, hs.lr]
  simp only [Program.withExit, BitVec.toNat_ofNat]
  exact Nat.mod_eq_of_lt hret.lt64

/-- `Summary0` version of `Ensures0.of_summary`: the summary's memory postcondition `Q` gives
the contract's postcondition. -/
theorem Ensures0.of_summary0 {pre spre : State → Prop} {post : State → State → Prop}
    {Q : State → Memory → Prop} (hsum : Summary0 p entry spre Q)
    (hpre : ∀ ret s, RetAddr p ret → CallSetup0 (p.withExit ret) entry args nres s → pre s →
      spre s)
    (hpost : ∀ ret s s', RetAddr p ret → CallSetup0 (p.withExit ret) entry args nres s → pre s →
      Q s s'.mem → post s s') :
    Ensures0 p entry args nres pre post :=
  Ensures0.of_summary hsum hpre fun ret s s' hret hs hp hr =>
    ⟨ABIReturn0.of_ret0 hr, hpost ret s s' hret hs hp hr.mem⟩

theorem Summary0.mono {pre pre' : State → Prop} {Q Q' : State → Memory → Prop}
    (hsum : Summary0 p entry pre Q) (hpre : ∀ s, pre' s → pre s)
    (hQ : ∀ s m, pre' s → Q s m → Q' s m) : Summary0 p entry pre' Q' :=
  Summary.mono hsum hpre fun s _ hp ⟨junk, f, v, fpsr, m, he, hq⟩ =>
    ⟨junk, f, v, fpsr, m, he, hQ s m hp hq⟩

/-- A summary of an ABI0 function holds in `p.withExit ret` when there is no code at `ret`. -/
theorem Summary0.withExit {pre : State → Prop} {Q : State → Memory → Prop} {ret : Nat}
    (hsum : Summary0 p entry pre Q) (hret : RetAddr p ret) :
    Summary0 (p.withExit ret) entry pre Q :=
  Summary.withExit hsum hret

/-- Use an ABI0 callee summary at a direct call (`BL f.abi0`): `s` is at the callee's entry
and the caller has stored the argument words at `8(RSP)`; the call returns in
`retState0 s junk f v fpsr m` for **every** choice of the unspecified registers, flags, SIMD&FP
registers and `FPSR`, and every memory `m` with `Q s m`. -/
theorem Summary0.call {pre : State → Prop} {Q : State → Memory → Prop} {Q' : Outcome → Prop}
    (hsum : Summary0 p entry pre Q) (hpc : s.pc = BitVec.ofNat 64 entry) (hpre : pre s)
    (h : ∀ junk f v fpsr m, Q s m → Reaches p (retState0 s junk f v fpsr m) Q') :
    Reaches p s Q' :=
  Reaches.call hsum hpc hpre fun _ _ ⟨junk, f, v, fpsr, m, he, hq⟩ => he ▸ h junk f v fpsr m hq

/-- Memory `m` with the words `ws` written at `base`, `base + 8`, ... -/
def writeWords (m : Memory) (base : Nat) : List W64 → Memory
  | [] => m
  | w :: ws => writeWords (m.writeLE base 8 w.toNat) (base + 8) ws

@[simp] theorem regions_writeWords (m : Memory) (base : Nat) (ws : List W64) :
    (writeWords m base ws).regions = m.regions := by
  induction ws generalizing m base with
  | nil => rfl
  | cons w ws ih => simp only [writeWords, ih, Memory.regions_writeLE]

theorem readLE_writeWords_below (m : Memory) (base a k : Nat) (ws : List W64)
    (h : a + k ≤ base) : (writeWords m base ws).readLE a k = m.readLE a k := by
  induction ws generalizing m base with
  | nil => rfl
  | cons w ws ih =>
    simp only [writeWords]
    rw [ih _ _ (by omega), Memory.readLE_writeLE_of_disjoint _ _ (by omega)]

theorem readLE_writeWords (m : Memory) (base : Nat) (ws : List W64) (i : Nat)
    (hi : i < ws.length) : (writeWords m base ws).readLE (base + 8 * i) 8 = ws[i].toNat := by
  induction ws generalizing m base i with
  | nil => simp at hi
  | cons w ws ih =>
    simp only [writeWords]
    cases i with
    | zero =>
      rw [Nat.mul_zero, Nat.add_zero, readLE_writeWords_below _ _ _ _ _ (by omega),
        Nat.add_zero, Memory.readLE_writeLE_self _ _ _ _]
      exact Nat.mod_eq_of_lt (by have := w.isLt; simpa using this)
    | succ i =>
      rw [show base + 8 * (i + 1) = base + 8 + 8 * i by omega]
      exact ih _ _ i (by simp at hi; omega)

/-- A canonical ABI0 call state built from any state `s`: `pc := entry`, `X30 := p.exitAddr`
and the argument words written into the frame (used to show `CallSetup0` is satisfiable). -/
def setup (p : Program) (entry : Nat) (args : List W64) (s : State) : State :=
  { s with
    pc := BitVec.ofNat 64 entry
    regs := fun i => if i = regLR then BitVec.ofNat 64 p.exitAddr else s.regs i
    mem := writeWords s.mem (s.sp.toNat + 8) args }

/-- `CallSetup0` is satisfiable: from any state with an aligned `SP` whose frame is writable. -/
theorem setup_callSetup0 (s : State) (hf : FrameOK s (args.length + nres))
    (hal : s.sp.toNat % 16 = 0) :
    CallSetup0 p entry args nres (setup p entry args s) where
  pc := rfl
  lr := by simp [setup]
  argWords := fun i hi => by
    simp only [setup]
    exact readLE_writeWords _ _ _ i hi
  frame := by
    refine ⟨hf.1, ?_⟩
    simp only [setup]
    rw [Memory.accessible_congr (regions_writeWords _ _ _)]
    exact hf.2
  spAligned := hal

end Lemmas

end GoABI0
end Janus
