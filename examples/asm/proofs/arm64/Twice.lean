import Extracted

/-!
# `Twice(x uint64) uint64` (Go assembly, ABI0, arm64) calling Go through the ABI0 → ABIInternal wrapper

```
TEXT ·Twice(SB), NOSPLIT, $16-16           // examples/asm/asm_arm64.s
	MOVD x+0(FP), R0 ; MOVD R0, 8(RSP)       // the callee's frame word 0
	CALL ·double(SB)                          // double is Go: links to double.abi0
	MOVD 16(RSP), R0 ; ADD $1, R0, R0 ; MOVD R0, ret+8(FP) ; RET
```

`double` is a Go function (ABIInternal, `x` in `R0`); assembly calls it with ABI0, so the
compiler emits the ABI0 → ABIInternal wrapper `double.abi0` (`<autogenerated>`: push a frame,
`MOVD 40(RSP), R0` — the frame word into the register —, `BL double`, `MOVD R0, 48(RSP)`, pop,
`RET`). The assembler adds `Twice`'s own frame prologue and epilogue (`MOVD.W R30, -32(RSP)`,
`MOVD R29, -8(RSP)`, …).

**Guarantee.** For all `x` and every ABI0 call state of `example.com/asm.Twice.abi0` in which
`[SP-72, SP+24)` is writable (the frames of `Twice` and of the wrapper, and the frame words),
the call returns (never faulting), obeys `ABIReturn0`, its result word is `2·x + 1` (mod `2^64`),
and its memory equals the call state's with that result word written, except inside the
scratch range `[SP-72, SP-8)` below `SP` (the caller's saved frame pointer at `[SP-8, SP)` is
kept).

**How (three layers).** `double_summary` (an ABIInternal `Summary` of the Go function),
`double0_summary` (the wrapper as an ABI0 `Summary0`, proved with `calls [double_summary]`; its
memory postcondition is a `MemFrame`, established with `MemFrame.writeLE_congr` and
`janus_frame`), and the theorem, with `calls [double0_summary]`.
-/

open Janus Janus.Arm64 Janus.GoABI Janus.GoABI0 Janus.Tactic Janus.Spec

namespace Proof

abbrev double : Nat := segAddr Extracted.program "example.com/asm.double"
abbrev double0 : Nat := segAddr Extracted.program "example.com/asm.double.abi0"

theorem double_summary :
    Summary Extracted.program double
      (fun s => (s.regs 30).toNat % 4 = 0 ∧ (s.regs 30).toNat < 2 ^ 56)
      (fun s s' => s' = { s with regs := setReg s.regs 0 (s.regs 0 + s.regs 0), pc := s.regs 30 }) := by
  intro s hpc ⟨h1, h2⟩
  janus_run

theorem double0_summary :
    Summary0 Extracted.program double0
      (fun s => (s.regs 30).toNat % 4 = 0 ∧ (s.regs 30).toNat < 2 ^ 56 ∧ StackOK s 40 24)
      (fun s m => MemFrame (s.mem.writeLE (s.sp.toNat + 16) 8
        (2 * s.mem.readLE (s.sp.toNat + 8) 8 % 2 ^ 64)) m [(s.sp.toNat - 40, s.sp.toNat - 8)]) := by
  intro s hpc ⟨h1, h2, hal, hb, ha, hst⟩
  janus_run calls [double_summary]
  refine MemFrame.writeLE_congr ?_ _ _ (by omega)
  janus_frame

theorem correctness (x : BitVec 64) :
    Ensures0 Extracted.program Extracted.entry [x] 1
      (fun s => StackOK s 72 24)
      (fun s s' => results0 s s' 1 1 = [2 * x + 1] ∧
        MemFrame (s.mem.writeLE (s.sp.toNat + 16) 8 (2 * x + 1).toNat) s'.mem
          [(s.sp.toNat - 72, s.sp.toNat - 8)]) := by
  intro ret hret s hs ⟨hal, hb, ha, hst⟩
  janus_intro0 hs
  janus_run calls [double0_summary]
  refine ⟨?_, ?_⟩
  · simp only [List.cons.injEq, and_true]
    apply BitVec.eq_of_toNat_eq
    simp only [BitVec.toNat_mul, BitVec.toNat_add, BitVec.toNat_ofNat]
  · refine MemFrame.writeLE_both ?_ _ _ _
    janus_frame

end Proof
