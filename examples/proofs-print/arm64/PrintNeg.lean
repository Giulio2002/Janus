/-- `runtime.printunlock` with the M's print count 1: `unlock2(&debuglock)`; afterwards the count is
0, the lock's key byte is cleared and `m.locks` is one lower (`unlock2`'s decrement). -/
theorem printunlock_last (impl : List Segment) (rt : List (Nat × Nat)) (LS : Nat)
    (hu : Unlock2Contract (P.link impl) (P.contractAddr "runtime.unlock2") rt LS) :
    Summary (P.link impl) (segAddr P "runtime.printunlock")
      (fun s => (s.regs 30).toNat % 4 = 0 ∧ (s.regs 30).toNat < 2 ^ 48 ∧ StackOK s (LS + 32) 0 ∧
        8 ≤ LS ∧ GuardOK s 0 ∧
        (s.regs 28).toNat + 56 ≤ 2 ^ 48 ∧ s.mem.accessible ((s.regs 28).toNat + 48) 8 false = true ∧
        s.mem.readLE ((s.regs 28).toNat + 48) 8 + 280 ≤ 2 ^ 48 ∧
        s.mem.accessible (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 16 true = true ∧
        s.mem.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 279) 1 = 1 ∧
        1 ≤ s.mem.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 4 ∧
        s.mem.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 4 + 3 < 2 ^ 31 ∧
        DL + 8 ≤ 2 ^ 48 ∧ s.mem.accessible DL 8 true = true ∧ lockHeld s.mem DL ∧
        InRanges DL 8 rt ∧ InRanges (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 4 rt ∧
        Outside (s.sp.toNat - (LS + 32)) (LS + 32) rt ∧ Outside ((s.regs 28).toNat + 16) 8 rt ∧
        Outside ((s.regs 28).toNat + 48) 8 rt ∧
        Outside (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 279) 1 rt ∧
        Apart DL 8 (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 16 ∧
        Apart ((s.regs 28).toNat + 48) 8 (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 16 ∧
        Sep (s.sp.toNat - (LS + 32)) (LS + 32) [((s.regs 28).toNat + 16, 8), ((s.regs 28).toNat + 48, 8),
          (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264, 16), (DL, 8)])
      (fun s s' => ∃ (junk : Nat → W64) (f : Flags) (v : Nat → BitVec 128) (m : Memory),
        s' = retState s junk [] f v m ∧
        MemFrame s.mem m (rt ++ [(s.sp.toNat - (LS + 32), s.sp.toNat - 8),
          (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 279, s.mem.readLE ((s.regs 28).toNat + 48) 8 + 280)]) ∧
        m.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 279) 1 = 0 ∧
        m.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 4 + 1 =
          s.mem.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 4 ∧
        m.readLE DL 1 = 0) := by
  -- PROOF printunlock_last
  intro s hpc ⟨h30a, h30b, ⟨hal, hb, ha, hw⟩, hLS, ⟨hg1, hg2, hg3⟩, hgm1, hgm2, hm1, hm2, hc0, hl0, hl31,
    hdl1, hdl2, hheld0, hin1, hin2, ho1, ho2, ho3, ho4, hapd, hapg, hout⟩
  simp only [lockHeld] at hheld0
  simp only [sep_cons, sep_nil, and_true] at hout
  obtain ⟨hout_1, hout_2, hout_3, hout_4⟩ := hout
  have f1 : Apart (s.sp.toNat - 40) 32 ((s.regs 28).toNat + 16) 8 := Apart.mono hout_1 (by omega) (by omega) (by omega) (by omega)
  have f2 : Apart (s.sp.toNat - 40) 32 ((s.regs 28).toNat + 48) 8 := Apart.mono hout_2 (by omega) (by omega) (by omega) (by omega)
  have f3 : Apart (s.sp.toNat - 40) 32 (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 264) 16 := Apart.mono hout_3 (by omega) (by omega) (by omega) (by omega)
  have f4 : Apart (s.sp.toNat - 40) 32 DL 8 := Apart.mono hout_4 (by omega) (by omega) (by omega) (by omega)
  janus_eval_nat h_dl : DL
  simp only [h_dl] at *
  have hlt : s.mem.readLE (s.mem.readLE ((s.regs 28).toNat + 48) 8 + 279) 1 < 128 := by omega
  janus_run [rotateRight_zero64, sext8_and255, ofNat_and255, setWidth32_ofNat, ofNat32_eq_zero,
    sext32_add_mod, sext8_add_mod, sext8_add_mod', hlt, hc0] calls [hu]
  rename_i _ _ _ _ m hfr hkey hlk _
  have e1 : m.readLE ((s.regs 28).toNat + 48) 8 = s.mem.readLE ((s.regs 28).toNat + 48) 8 := by
    janus_simp
  rw [e1] at hlk
  refine ⟨_, _, _, _, by ret_state, by janus_frame, ?_, ?_, ?_⟩
  all_goals janus_simp
  · exact hlk
  · exact hkey

/-! ## Non-vacuity: code for the three contracts and a call state

`Janus.Print.Sat`'s witness code (`lock2Code`, `unlock2Code`, `memmoveCode`, proved there against
the contracts on a toy program) linked at the contract addresses of this binary, proved again
here against the contracts for the linked program; the runtime-owned ranges `wrt` (the mutex key
and `m.locks`); and a memory `wmem` holding the read-only data, a stack, `g` and its M, and the
print globals (zero: not panicking, backlog index 0, no `overrideWrite`, `debuglock` free). Each
example's `Witness.nonvacuous` builds its call state on it. -/

namespace Witness

open Janus.Print.Sat

def L2 : Nat := P.contractAddr "runtime.lock2"
def U2 : Nat := P.contractAddr "runtime.unlock2"
def MM : Nat := P.contractAddr "runtime.memmove"

def implAt : List Segment :=
  [⟨"lock2", L2, lock2Code⟩, ⟨"unlock2", U2, unlock2Code⟩, ⟨"memmove", MM, memmoveCode⟩]

/-- The program linked with it, as a closed program. -/
def linked : Program := { P with segments := P.segments ++ implAt }

theorem linked_eq : P.link implAt = linked := rfl

set_option maxHeartbeats 4000000 in
theorem lock2_model (rt : List (Nat × Nat)) (stack : Nat) :
    Lock2Contract (P.link implAt) (P.contractAddr "runtime.lock2") rt stack := by
  rw [linked_eq]
  intro s hpc ⟨⟨h30a, h30b, hal, hst, h8, hsp, hw⟩, ⟨hl1, hl2, hin1, hg1, hg2, hgo, hm1, hm2, hin2, hap, hlo, hhi⟩, hfree⟩
  simp only [mLocksOf, gM, mLocks] at *
  have hd1 := hin1.disjoint hgo
  have hd2 := hin2.disjoint hgo
  unfold Apart at hap
  janus_run
  refine ⟨0, _, _, _, _, by ret_state, by janus_frame, ?_, ?_⟩
  all_goals janus_simp
  simp only [BitVec.toNat_setWidth, BitVec.toNat_add, BitVec.toNat_ofNat]
  omega

set_option maxHeartbeats 4000000 in
theorem unlock2_model (rt : List (Nat × Nat)) (stack : Nat) :
    Unlock2Contract (P.link implAt) (P.contractAddr "runtime.unlock2") rt stack := by
  rw [linked_eq]
  intro s hpc ⟨⟨h30a, h30b, hal, hst, h8, hsp, hw⟩, ⟨hl1, hl2, hin1, hg1, hg2, hgo, hm1, hm2, hin2, hap, hlo, hhi⟩, hheld⟩
  simp only [mLocksOf, gM, mLocks] at *
  have hd1 := hin1.disjoint hgo
  have hd2 := hin2.disjoint hgo
  unfold Apart at hap
  janus_run
  refine ⟨0, _, _, _, _, by ret_state, by janus_frame, ?_, ?_⟩
  all_goals janus_simp
  simp only [BitVec.toNat_setWidth, BitVec.toNat_sub, BitVec.toNat_ofNat]
  omega

theorem mm_loop (s0 : State) (h30a : (s0.regs 30).toNat % 4 = 0) (h30b : (s0.regs 30).toNat < 2 ^ 48)
    (D Sr N : Nat) (hD : D + N ≤ 2 ^ 48) (hS : Sr + N ≤ 2 ^ 48)
    (hwd : s0.mem.accessible D N true = true) (hrs : s0.mem.accessible Sr N false = true)
    (hdisj : D + N ≤ Sr ∨ Sr + N ≤ D) :
    ∀ k (S : State), 0 < k → k ≤ N →
      S.pc = BitVec.ofNat 64 (MM + 4) → S.regs 0 = BitVec.ofNat 64 (D + (N - k)) →
      S.regs 1 = BitVec.ofNat 64 (Sr + (N - k)) → S.regs 2 = BitVec.ofNat 64 k →
      S.regs 30 = s0.regs 30 → S.sp = s0.sp → S.regs 18 = s0.regs 18 → S.regs 28 = s0.regs 28 →
      S.regs 29 = s0.regs 29 →
      S.dczid = s0.dczid → S.tpidr = s0.tpidr → S.fpcr = s0.fpcr → S.fpsr = s0.fpsr →
      MemFrame s0.mem S.mem [(D, D + N)] →
      readBytes S.mem D (N - k) = readBytes s0.mem Sr (N - k) →
      ReachesRet linked (s0.regs regLR) S (fun s' =>
        ∃ (junk : Nat → W64) (f : Flags) (v : Nat → BitVec 128) (m : Memory),
          s' = retState s0 junk [] f v m ∧ MemFrame s0.mem m [(D, D + N)] ∧
          readBytes m D N = readBytes s0.mem Sr N) := by
  intro k
  induction k with
  | zero => intro S hk; omega
  | succ k ih =>
    intro S _ hk hpc h0 h1 h2 h30 hsp h18 h28 h29 hdz htp hfc hfs hf hrb
    have hrb' := readBytes_copy_step S.mem s0.mem D Sr (N - (k + 1)) hrb
    rw [show N - (k + 1) + 1 = N - k by omega] at hrb'
    by_cases hk0 : k = 0
    · subst hk0
      janus_run
      refine ⟨_, _, _, _, by ret_state [h18, h28, h29, hsp, hdz, htp, hfc, hfs], by janus_frame, ?_⟩
      simpa using hrb'
    · janus_run until [MM + 4]
      refine ih _ (by omega) (by omega) ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
      all_goals try (simp only [setReg_apply]; first | assumption | rfl)
      all_goals try (apply BitVec.eq_of_toNat_eq; simp [setReg]; omega)
      all_goals try janus_frame
      all_goals simpa using hrb'

set_option maxHeartbeats 4000000 in
theorem memmove_model : MemmoveContract (P.link implAt) (P.contractAddr "runtime.memmove") := by
  rw [linked_eq]
  intro s hpc ⟨h30a, h30b, hD, hS, hwd, hrs, hdisj⟩
  by_cases hN : (s.regs 2).toNat = 0
  · janus_run
    refine ⟨_, _, _, _, by ret_state, ⟨fun _ _ _ => rfl, fun _ _ _ => rfl⟩, ?_⟩
    simp [hN, readBytes]
  · have hx0 : s.regs 0 = BitVec.ofNat 64 ((s.regs 0).toNat + ((s.regs 2).toNat - (s.regs 2).toNat)) := by simp
    have hx1 : s.regs 1 = BitVec.ofNat 64 ((s.regs 1).toNat + ((s.regs 2).toNat - (s.regs 2).toNat)) := by simp
    janus_run until [MM + 4]
    refine mm_loop s h30a h30b _ _ _ hD hS hwd hrs hdisj (s.regs 2).toNat _ (by omega) (Nat.le_refl _)
      ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    all_goals try (simp only [setReg_apply]; first | assumption | rfl)
    all_goals try (simp [setReg])
    all_goals try exact ⟨fun _ _ _ => rfl, fun _ _ _ => rfl⟩
    all_goals simp [readBytes]

/-- The witness goroutine, its M, the stack pointer and the return address. -/
def WG : Nat := 0x50000
def WM : Nat := 0x51000
def WSP : Nat := 0x48000
def ret : Nat := 0x200000

/-- The runtime-owned ranges: the mutex key `debuglock` and `m.locks`. -/
def wrt : List (Nat × Nat) := [(DL, DL + 8), (WM + 264, WM + 268)]

/-- The byte of the read-only data at `a`, if any. -/
def dbyte (a : Nat) : Option Nat :=
  P.data.findSome? fun d => if d.base ≤ a ∧ a < d.base + d.bytes.length then d.bytes[a - d.base]? else none

/-- The witness memory: the read-only data (read-only regions), `g.m = WM` (`g` read-only), the M,
the print globals' range (from `runtime.overrideWrite` to the end of `printBacklog`) and the
stack (writable); every other byte 0. -/
def wmem : Memory :=
  ⟨fun a => BitVec.ofNat 8 ((dbyte a).getD (if a = WG + 49 then 0x10 else if a = WG + 50 then 0x05 else 0)),
    [⟨WG, 0x100, false⟩, ⟨WM, 0x200, true⟩, ⟨WSP - 0x8000, 0x10000, true⟩, ⟨OW, BL + 512 - OW, true⟩] ++
      P.data.map fun d => ⟨d.base, d.bytes.length, false⟩⟩

/-- A call state of the example with arguments `r` (`X0`, `X1`, …). -/
def wstate (r : Nat → W64) : State :=
  { regs := fun i => if i = 28 then BitVec.ofNat 64 WG else if i = 30 then BitVec.ofNat 64 ret else r i,
    sp := BitVec.ofNat 64 WSP, pc := BitVec.ofNat 64 Extracted.entry,
    flags := ⟨false, false, false, false⟩, mem := wmem }

theorem hret : RetAddr (P.link implAt) ret := RetAddr.of_check (by decide +kernel)

theorem wmem_data : P.DataLoaded wmem := by
  unfold Program.DataLoaded; decide +kernel

theorem wrt_data : DataOutside P wrt := by
  unfold DataOutside; simp only [wrt, outside_cons, outside_nil, and_true]; decide +kernel

/-- `PrintReady` looks only at `SP`, `g` and memory. -/
theorem ready_of {A : PrintGlobals} {rt : List (Nat × Nat)} {b a j : Nat} {s s' : State}
    (h1 : s'.sp = s.sp) (h2 : s'.regs 28 = s.regs 28) (h3 : s'.mem = s.mem) (h : PrintReady A rt b a j s) :
    PrintReady A rt b a j s' := by
  unfold PrintReady StackOK GuardOK at *; rw [h1, h2, h3]; exact h

theorem ready0 (above : Nat) (ha : above = 16 ∨ above = 24) :
    PrintReady ⟨PK, BI, BL, OW, DL⟩ wrt 1088 above 256 (wstate fun _ => 0) := by
  rcases ha with rfl | rfl <;>
  · unfold PrintReady StackOK GuardOK
    simp only [sep_cons, sep_nil, and_true, wrt, outside_cons, outside_nil, InRanges, lockHeld, Apart,
      gM, gWritebuf, mLocks, mDying, mPrintlock, List.mem_cons, List.mem_nil_iff, or_false,
      exists_eq_or_imp, exists_eq_left]
    repeat' apply And.intro
    all_goals decide +kernel

theorem ready (r : Nat → W64) (above : Nat) (ha : above = 16 ∨ above = 24) :
    PrintReady ⟨PK, BI, BL, OW, DL⟩ wrt 1088 above 256 (wstate r) :=
  ready_of rfl rfl rfl (ready0 above ha)

end Witness

/-! ## `PrintNeg` -/

theorem fmtInt_neg17 : Janus.Spec.Print.fmtInt (-17#64) = Janus.Spec.Print.ofString "-17" := by
  decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 80000000 in
theorem correctness (impl : List Segment) (rt : List (Nat × Nat)) (E : KEnv)
    (hl : Lock2Contract (P.link impl) (P.contractAddr "runtime.lock2") rt 1024)
    (hu : Unlock2Contract (P.link impl) (P.contractAddr "runtime.unlock2") rt 1024)
    (hmm : MemmoveContract (P.link impl) (P.contractAddr "runtime.memmove")) :
    EnsuresK (P.link impl) E Extracted.entry []
      (fun s _ => PrintReady ⟨PK, BI, BL, OW, DL⟩ rt 1088 16 256 s ∧ P.DataLoaded s.mem ∧
        DataOutside P rt)
      (fun _ k _ k' => ∃ es, k' = k.appendTrace es ∧
        Emits 2 [Janus.Spec.Print.ofString "-17"] es) := by
  intro ret hret s k hs ⟨hpr, hd, hdo⟩
  dsimp only [PrintReady] at hpr
  obtain ⟨⟨hal, hb, ha, hw⟩, ⟨hg1, hg2, hg3⟩, hg0, hgl, hgm, hwb, h_rd_wb, hm1, hm2, h_rd_dy, h_rd_c,
    hlk31, hpk, hbi, hbi2, hbl, how, h_rd_ow, hdl, hfree, hin1, hin2, ho1, ho2, ho3, ho4, ho5, ho6,
    ho7, ho8, ho9, ho10, hsep1, hsep2, hsep3, hsep4, hsep5, hsep6⟩ := hpr
  simp only [sep_cons, sep_nil, and_true, gM, gWritebuf, mLocks, mDying, mPrintlock] at *
  obtain ⟨a1, a2, a3, a4, a6, a7, a8, a9, aD⟩ := hsep1
  obtain ⟨b1, b2, b3, b5, b6, b7, b8, bD⟩ := hsep2
  obtain ⟨d1, d2, dD1⟩ := hsep3
  obtain ⟨d3, d4, dD2⟩ := hsep4
  obtain ⟨d5, d6, dD3⟩ := hsep5
  obtain ⟨e1, e2⟩ := hsep6
  janus_intro hs
  janus_data hd [hw, hm2, hbi, hbl]
  -- the read-only data it prints from, outside `rt`
  janus_eval_nat h_pk : PK
  janus_eval_nat h_bi : BI
  janus_eval_nat h_bl : BL
  janus_eval_nat h_ow : OW
  simp only [h_pk, h_bi, h_bl, h_ow] at *
  janus_eval_nat h_pk : PK
  janus_eval_nat h_bi : BI
  janus_eval_nat h_bl : BL
  janus_eval_nat h_ow : OW
  janus_eval_nat h_sm : SM
  have hsmo : Outside SM 200 rt := hdo.of_dataRead (by rw [h_sm]; decide +kernel)
  rw [h_sm] at hsmo
  apply ReturnsK.of_reaches
  janus_run until [segAddr P "runtime.printlock"]
  refine Reaches.call (Summary.withExit (printlock_free impl rt 1024 hl) hret) rfl ?_ (fun s1 hr1 hpost1 => ?_)
  · refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_⟩, ?_, ⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?nl, ?in1, ?in2, ?_, ?_, ?_, ?_, ?_, ?_, ?sep⟩
    case nl => simp only [lockHeld] at hfree ⊢; janus_simp; exact hfree
    case in1 => janus_simp; exact hin1
    case in2 => janus_simp; exact hin2
    case sep =>
      simp only [sep_cons, sep_nil, and_true]
      janus_simp
      refine ⟨?_, ?_, ?_, ?_⟩ <;> apart_mono
    all_goals kobl
  · obtain ⟨junk1, f1, v1, m1, rfl, hfr1, h_rd_c1, h_rd_l1, hheld1⟩ := hpost1
    revert hfr1 h_rd_c1 h_rd_l1 hheld1
    janus_simp
    intro hfr1 h_rd_c1 h_rd_l1 hheld1
    janus_run until [segAddr P "runtime.printint"]
    apply ReturnsK.to_reaches
    apply printint_k impl hmm E ret hret _ k (s.sp.toNat - 32) (s.regs 28).toNat
      (s.mem.readLE ((s.regs 28).toNat + 48) 8) (-17#64)
    case hk =>
      rintro S2 K2 ⟨junk2, f2, v2, m2, es1, rfl, hfr2, h_rd_c2, h_rd_l2, hbi2', rfl, hem1⟩
      dsimp only at hfr2 h_rd_c2 h_rd_l2 hbi2'
      simp only [h_bi, h_bl] at hfr2 hbi2'
      apply ReturnsK.of_reaches
      janus_run until [segAddr P "runtime.printunlock"]
      refine Reaches.call (Summary.withExit (printunlock_last impl rt 1024 hu) hret) rfl ?_
        (fun s5 hr5 hpost5 => ?_)
      · refine ⟨?_, ?_, ⟨?_, ?_, ?_, ?_⟩, ?_, ⟨?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?hl, ?in1, ?in2, ?_, ?_, ?_, ?_, ?_, ?_, ?sep⟩
        case hl => simp only [lockHeld]; janus_simp; exact hheld1
        case in1 => janus_simp; exact hin1
        case in2 => janus_simp; exact hin2
        case sep =>
          simp only [sep_cons, sep_nil, and_true]
          janus_simp
          refine ⟨?_, ?_, ?_, ?_⟩ <;> apart_mono
        all_goals kobl
      · obtain ⟨junk5, f5, v5, m5, rfl, hfr5, h_rd_c5, h_rd_l5, hkey5⟩ := hpost5
        revert hfr5 h_rd_c5 h_rd_l5 hkey5
        janus_simp
        intro hfr5 h_rd_c5 h_rd_l5 hkey5
        janus_run
        refine ⟨es1, rfl, ?_⟩
        rw [← fmtInt_neg17]
        exact hem1
    all_goals try simp only [h_pk, h_bi, h_bl, h_ow, h_sm]
    all_goals try (intro j hj; janus_simp; first | done | exact readLE_of_dataRead hd (by rw [← h_sm]; exact smalls_data j hj))
    case hsp => apply BitVec.eq_of_toNat_eq; simp; omega
    all_goals kobl

/-- **Full output**: if fd 2 grew by as many bytes as the pieces hold, it grew by exactly them. -/
theorem full_output (impl : List Segment) (rt : List (Nat × Nat)) (E : KEnv)
    (hl : Lock2Contract (P.link impl) (P.contractAddr "runtime.lock2") rt 1024)
    (hu : Unlock2Contract (P.link impl) (P.contractAddr "runtime.unlock2") rt 1024)
    (hmm : MemmoveContract (P.link impl) (P.contractAddr "runtime.memmove")) :
    EnsuresK (P.link impl) E Extracted.entry []
      (fun s _ => PrintReady ⟨PK, BI, BL, OW, DL⟩ rt 1088 16 256 s ∧ P.DataLoaded s.mem ∧
        DataOutside P rt)
      (fun s k _ k' => (k'.output 2).length = (k.output 2).length + (Janus.Spec.Print.ofString "-17").length →
        k'.output 2 = k.output 2 ++ (Janus.Spec.Print.ofString "-17")) := by
  intro ret hret s k hs hpre
  refine (correctness impl rt E hl hu hmm ret hret s k hs hpre).mono ?_ (fun _ _ h => h)
  rintro s' k' ⟨habi, es, rfl, hem⟩
  refine ⟨habi, fun hlen => ?_⟩
  have h := hem.full (k := k) (by simpa [List.append_assoc] using hlen)
  simpa [List.append_assoc] using h

namespace Witness

theorem setup : CallSetup ((P.link implAt).withExit ret) Extracted.entry [] (wstate fun _ => 0) :=
  ⟨rfl, rfl, by intro i h; simp at h⟩

/-- All hypotheses of `correctness` hold together: the witness code at the three contract
addresses, the ranges `wrt`, an admissible return address and a call state ready to print. -/
theorem nonvacuous : ∃ (impl : List Segment) (rt : List (Nat × Nat)) (ret : Nat) (s : State),
    Lock2Contract (P.link impl) (P.contractAddr "runtime.lock2") rt 1024 ∧
    Unlock2Contract (P.link impl) (P.contractAddr "runtime.unlock2") rt 1024 ∧
    MemmoveContract (P.link impl) (P.contractAddr "runtime.memmove") ∧
    RetAddr (P.link impl) ret ∧ CallSetup ((P.link impl).withExit ret) Extracted.entry [] s ∧
    (PrintReady ⟨PK, BI, BL, OW, DL⟩ rt 1088 16 256 s ∧ P.DataLoaded s.mem ∧ DataOutside P rt) :=
  ⟨implAt, wrt, ret, wstate fun _ => 0, lock2_model wrt 1024, unlock2_model wrt 1024, memmove_model,
    hret, setup, ready _ 16 (Or.inl rfl), wmem_data, wrt_data⟩

/-- So the guarantee is reached: from the witness state, for every kernel, `print(-17)` returns
and the trace gains what `write(2, "-17")` may append. -/
theorem returns (E : KEnv) (k : Kern) :
    ReturnsK ((P.link implAt).withExit ret) E
      (fun s' k' => FFI.ABIReturnC (wstate fun _ => 0) s' ∧
        ∃ es, k' = k.appendTrace es ∧ Emits 2 [Janus.Spec.Print.ofString "-17"] es)
      (fun _ _ => False) (wstate fun _ => 0) k :=
  correctness implAt wrt E (lock2_model wrt 1024) (unlock2_model wrt 1024) memmove_model ret hret _ k setup
    ⟨ready _ 16 (Or.inl rfl), wmem_data, wrt_data⟩

end Witness

end Proof
