-abbrev real := Float
+/- JanusASL: Sail's `real` as an exact rational (Lean core `Rat`), not `Float`.
+   The upstream file used `Float`: ASL computes SDIV/UDIV as RoundTowardsZero(Real(a) / Real(b)),
+   which a 53-bit mantissa gets wrong for 64-bit operands, and `round_down` was
+   `x.toUInt64.toNat`, which maps every negative value to 0. Only `sqrt_real` has no exact
+   rational meaning; it is not reached by the Janus slice and is defined via Float. -/
+abbrev real := Rat
 
 -- val "neg_real" : real -> real
 def neg_real (x : real) : real := -x
@@ -20,38 +25,40 @@ def add_real (x y : real) : real := x + y
 -- val "div_real" : (real, real) -> real
 def div_real (x y : real) : real := x / y
 
--- val sqrt = pure "sqrt_real" : real -> real
-def sqrt_real (x : real) : real := Float.sqrt x
+-- val sqrt = pure "sqrt_real" : real -> real  (not exact; unused by the Janus slice)
+def sqrt_real (x : real) : real :=
+  let f := Float.sqrt (Float.ofInt x.num / Float.ofNat x.den)
+  if f.isFinite then Rat.ofInt (Float.toInt64 (f * 1048576.0)).toInt / 1048576 else 0
 
 -- val "abs_real" : real -> real
-def abs_real (x : real) : real := x.abs
+def abs_real (x : real) : real := if x < 0 then -x else x
 
 -- val floor = pure "round_down" : real -> int
-def round_down (x : real) : Int := x.toUInt64.toNat
+def round_down (x : real) : Int := x.floor
 
 -- val ceil = pure "round_up" : real -> int
-def round_up (x : real) : Int := round_down (x + 0.5)
+def round_up (x : real) : Int := x.ceil
 
 -- val "to_real" : int -> real
-def to_real (x : Int) : real := Float.ofInt x
+def to_real (x : Int) : real := Rat.ofInt x
 
 -- val "eq_real" : (real, real) -> bool
 def eq_real (x y : real) : Bool := x == y
 
 -- val "lt_real" : (real, real) -> bool
-def lt_real (x y : real) : Bool := x < y
+def lt_real (x y : real) : Bool := decide (x < y)
 
 -- val "gt_real" : (real, real) -> bool
-def gt_real (x y : real) : Bool := x > y
+def gt_real (x y : real) : Bool := decide (x > y)
 
 -- val "lteq_real" : (real, real) -> bool
-def lteq_real (x y : real) : Bool := x ≤ y
+def lteq_real (x y : real) : Bool := decide (x ≤ y)
 
 -- val "gteq_real" : (real, real) -> bool
-def gteq_real (x y : real) : Bool := x ≥ y
+def gteq_real (x y : real) : Bool := decide (x ≥ y)
 
 -- val pow_real = pure "real_power" : (real, int) -> real
-def real_power (x : real) (n : Int) : real := Float.pow x (Float.ofInt n)
+def real_power (x : real) (n : Int) : real := x ^ n
 
