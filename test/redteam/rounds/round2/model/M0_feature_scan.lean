import Janus
/-! M0: which CPU features do the instructions of the shipped example theorems need?
Decodes every word of every `artifacts/<Name>/Extracted.lean` segment and reports the
instructions whose acceptance assumes an optional feature (FEAT_LSE, FEAT_LRCPC, FEAT_AES) or
the (formally optional) FP/AdvSIMD unit, plus DC ZVA / MRS DCZID (base Armv8.0, IMPLEMENTATION
DEFINED block size).
Run (from a copy of the arm64cov2 tree, after `lake build Janus`):
  lake env lean audit/round2/model/M0_feature_scan.lean -/
open Janus.Arm64

def feat : Instr → Option String
  | .atomic .. => some "LSE"  | .cas .. => some "LSE" | .casp .. => some "LSE"
  | .ldstOrdered _ _ true .. => some "LRCPC"
  | .vAes .. => some "AES"
  | .dcZva .. => some "DCZVA" | .mrsDczid .. => some "MRS-DCZID" | .mrsTpidr .. => some "MRS-TPIDR"
  | .vldstMulti .. | .vldstSingle .. | .vldrLit .. | .vldstUImm .. | .vldstImm9 .. | .vldstReg ..
  | .vldstPair .. | .vThreeSame .. | .vScalarThreeSame .. | .vCopy .. | .vAcross .. | .vTwoMisc ..
  | .vShiftImm .. | .vModImm .. | .vExt .. | .vTbl .. | .fmovGen .. => some "AdvSIMD/FP"
  | _ => none

