import Janus
open Janus.Amd64

/-! Decoder/executor probes. Run: `lake env lean audit/round2/amd64/Probe.lean`. -/

def dec (bs : List Nat) : String := match decode bs with
  | some (i, n) => " ".intercalate (((toString (repr i)).replace "Janus.Amd64." "").splitOn "\n" |>.map String.trimAscii |>.map (·.toString)) ++ s!" len={n}"
  | none => "REJECT"

-- string ops & prefixes
#eval show IO Unit from do
  for (n, r) in [
  ("F3 A4 rep movsb", dec [0xF3,0xA4]),
  ("F2 A4 repne movsb", dec [0xF2,0xA4]),
  ("66 F3 A5 rep movsw", dec [0x66,0xF3,0xA5]),
  ("F3 48 A5 rep movsq", dec [0xF3,0x48,0xA5]),
  ("48 F3 A5 (REX before F3)", dec [0x48,0xF3,0xA5]),
  ("67 F3 A4 addr32", dec [0x67,0xF3,0xA4]),
  ("64 A4 fs movsb", dec [0x64,0xA4]),
  ("3E A4 ds movsb", dec [0x3E,0xA4]),
  ("F3 AA rep stosb", dec [0xF3,0xAA]),
  ("F3 48 AB rep stosq", dec [0xF3,0x48,0xAB]),
  ("F3 01 C0 rep add", dec [0xF3,0x01,0xC0]),
  ("F3 C3 rep ret", dec [0xF3,0xC3]),
  ("F3 90 pause", dec [0xF3,0x90]),
  ("F3 41 90", dec [0xF3,0x41,0x90]),
  ("F0 A4 lock movsb", dec [0xF0,0xA4]),
  ("F0 F3 A4", dec [0xF0,0xF3,0xA4]),
  ("A6 cmpsb", dec [0xA6]), ("AC lodsb", dec [0xAC]), ("AE scasb", dec [0xAE]),
  ("FD std", dec [0xFD]), ("FC cld", dec [0xFC]), ("9D popf", dec [0x9D])
] do IO.println s!"{n} => {r}"
-- LOCK
#eval show IO Unit from do
  for (n, r) in [
  ("F0 48 01 08 lock add [rax],rcx", dec [0xF0,0x48,0x01,0x08]),
  ("F0 48 01 C8 lock add rax,rcx", dec [0xF0,0x48,0x01,0xC8]),
  ("F0 48 03 08 lock add rcx,[rax]", dec [0xF0,0x48,0x03,0x08]),
  ("F0 48 39 08 lock cmp", dec [0xF0,0x48,0x39,0x08]),
  ("F0 48 89 08 lock mov", dec [0xF0,0x48,0x89,0x08]),
  ("F0 48 87 08 lock xchg mem", dec [0xF0,0x48,0x87,0x08]),
  ("F0 48 87 C8 lock xchg reg", dec [0xF0,0x48,0x87,0xC8]),
  ("F0 48 0F C1 08 lock xadd", dec [0xF0,0x48,0x0F,0xC1,0x08]),
  ("F0 48 0F B1 08 lock cmpxchg", dec [0xF0,0x48,0x0F,0xB1,0x08]),
  ("F0 0F C7 08 lock cmpxchg8b", dec [0xF0,0x0F,0xC7,0x08]),
  ("F0 48 0F C7 08 lock cmpxchg16b", dec [0xF0,0x48,0x0F,0xC7,0x08]),
  ("F0 48 F7 18 lock neg", dec [0xF0,0x48,0xF7,0x18]),
  ("F0 48 F7 20 lock mul", dec [0xF0,0x48,0xF7,0x20]),
  ("F0 48 F7 00 lock test", dec [0xF0,0x48,0xF7,0x00,1,0,0,0]),
  ("F0 48 0F BA 28 05 lock bts", dec [0xF0,0x48,0x0F,0xBA,0x28,5]),
  ("F0 48 0F BA 20 05 lock bt", dec [0xF0,0x48,0x0F,0xBA,0x20,5]),
  ("F0 90", dec [0xF0,0x90]),
  ("F0 0F AE F0 lock mfence", dec [0xF0,0x0F,0xAE,0xF0]),
  ("F0 48 83 00 01 lock add imm8", dec [0xF0,0x48,0x83,0x00,1]),
  ("F0 48 FF 00 lock inc", dec [0xF0,0x48,0xFF,0x00]),
  ("F0 48 FF 30 lock push m", dec [0xF0,0x48,0xFF,0x30]),
  ("F0 48 D1 20 lock shl", dec [0xF0,0x48,0xD1,0x20])
] do IO.println s!"{n} => {r}"
-- SSE / fences / features
#eval show IO Unit from do
  for (n, r) in [
  ("0F 28 00 movaps", dec [0x0F,0x28,0x00]),
  ("66 0F 6F 00 movdqa", dec [0x66,0x0F,0x6F,0x00]),
  ("F3 0F 6F 00 movdqu", dec [0xF3,0x0F,0x6F,0x00]),
  ("0F 6F 00 mmx movq", dec [0x0F,0x6F,0x00]),
  ("66 0F E7 00 movntdq", dec [0x66,0x0F,0xE7,0x00]),
  ("0F 2B 00 movntps", dec [0x0F,0x2B,0x00]),
  ("0F C3 00 movnti", dec [0x0F,0xC3,0x00]),
  ("C5 F8 77 vzeroupper", dec [0xC5,0xF8,0x77]),
  ("C5 FE 6F 00 vmovdqu", dec [0xC5,0xFE,0x6F,0x00]),
  ("0F AE E8 lfence", dec [0x0F,0xAE,0xE8]),
