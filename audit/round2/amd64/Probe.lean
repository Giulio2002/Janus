  ("0F AE F0 mfence", dec [0x0F,0xAE,0xF0]),
  ("0F AE F8 sfence", dec [0x0F,0xAE,0xF8]),
  ("66 0F AE F8 pcommit/?", dec [0x66,0x0F,0xAE,0xF8]),
  ("0F AE 38 clflush", dec [0x0F,0xAE,0x38]),
  ("F3 0F BD C1 lzcnt", dec [0xF3,0x0F,0xBD,0xC1]),
  ("F3 0F BC C1 tzcnt", dec [0xF3,0x0F,0xBC,0xC1]),
  ("F3 0F B8 C1 popcnt", dec [0xF3,0x0F,0xB8,0xC1]),
  ("F3 0F 1E FA endbr64", dec [0xF3,0x0F,0x1E,0xFA]),
  ("66 0F 1F 44 00 00 nopw", dec [0x66,0x0F,0x1F,0x44,0,0]),
  ("0F 18 00 prefetchnta", dec [0x0F,0x18,0x00]),
  ("0F 0D 08 prefetchw", dec [0x0F,0x0D,0x08]),
  ("66 0F D6 C1 movq xmm1,xmm0", dec [0x66,0x0F,0xD6,0xC1]),
  ("66 48 0F 7E C0 movq rax,xmm0", dec [0x66,0x48,0x0F,0x7E,0xC0]),
  ("66 0F 7E C0 movd eax,xmm0", dec [0x66,0x0F,0x7E,0xC0]),
  ("66 48 0F 6E C0 movq xmm0,rax", dec [0x66,0x48,0x0F,0x6E,0xC0]),
  ("65 48 8B 04 25 .. gs mov", dec [0x65,0x48,0x8B,0x04,0x25,0,0,0,0]),
  ("64 48 8B 04 25 f8ff.. fs mov", dec [0x64,0x48,0x8B,0x04,0x25,0xF8,0xFF,0xFF,0xFF]),
  ("67 48 8B 00 addr32 mov", dec [0x67,0x48,0x8B,0x00]),
  ("0F A2 cpuid", dec [0x0F,0xA2]),
  ("0F 31 rdtsc", dec [0x0F,0x31]),
  ("87 C0 xchg eax,eax", dec [0x87,0xC0]),
  ("90 nop", dec [0x90])
] do IO.println s!"{n} => {r}"
