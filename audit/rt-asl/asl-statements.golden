STMT JanusASL.Proofs.ldstReg_agree : ∀ {w : Nat}, w < 2 ^ 32 → w / 2 ^ 27 % 8 = 7 → w / 2 ^ 26 % 2 = 0 → w / 2 ^ 24 % 4 = 0 → w / 2 ^ 21 % 2 = 1 → w / 2 ^ 10 % 4 = 2 → w / 2 ^ 14 % 2 = 1 → Janus.Arm64.validSizeOpc (w / 2 ^ 30 % 4) (w / 2 ^ 22 % 4) = Bool.true → ¬(w / 2 ^ 30 % 4 = 3 ∧ w / 2 ^ 22 % 4 = 2) → ∀ {js js' : Janus.Arm64.State} {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.MemRel js.mem s → JanusASL.Proofs.LinuxEL0Config s → JanusASL.Proofs.UserMapped js.mem s → Janus.Arm64.step w js = Except.ok js' → ∃ s', EStateM.run (ArmASL.Functions.janus_step (BitVec.ofNat 32 w)) s = EStateM.Result.ok ArmASL.JanusOutcome.Janus_OK s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.MemRel js'.mem s' ∧ JanusASL.Proofs.LinuxEL0Config s'
STMT JanusASL.Proofs.ldrLit_agree : ∀ {w : Nat}, w < 2 ^ 32 → w / 2 ^ 27 % 8 = 3 → w / 2 ^ 26 % 2 = 0 → w / 2 ^ 24 % 4 = 0 → w / 2 ^ 30 % 4 ≠ 3 → ∀ {js js' : Janus.Arm64.State} {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.MemRel js.mem s → JanusASL.Proofs.LinuxEL0Config s → JanusASL.Proofs.UserMapped js.mem s → Janus.Arm64.step w js = Except.ok js' → ∃ s', EStateM.run (ArmASL.Functions.janus_step (BitVec.ofNat 32 w)) s = EStateM.Result.ok ArmASL.JanusOutcome.Janus_OK s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.MemRel js'.mem s' ∧ JanusASL.Proofs.LinuxEL0Config s'
STMT JanusASL.Proofs.ldstPair_agree : ∀ {w : Nat}, w < 2 ^ 32 → w / 2 ^ 27 % 8 = 5 → w / 2 ^ 26 % 2 = 0 → w / 2 ^ 25 % 2 = 0 → w / 2 ^ 23 % 4 ≠ 0 → w / 2 ^ 30 % 4 ≠ 3 → ¬(w / 2 ^ 30 % 4 = 1 ∧ w / 2 ^ 22 % 2 = 0) → (w / 2 ^ 22 % 2 = 1 → w % 32 ≠ w / 2 ^ 10 % 32) → (w / 2 ^ 23 % 4 ≠ 2 → ¬((w % 32 = w / 2 ^ 5 % 32 ∨ w / 2 ^ 10 % 32 = w / 2 ^ 5 % 32) ∧ w / 2 ^ 5 % 32 ≠ 31)) → ∀ {js js' : Janus.Arm64.State} {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.MemRel js.mem s → JanusASL.Proofs.LinuxEL0Config s → JanusASL.Proofs.UserMapped js.mem s → Janus.Arm64.step w js = Except.ok js' → ∃ s', EStateM.run (ArmASL.Functions.janus_step (BitVec.ofNat 32 w)) s = EStateM.Result.ok ArmASL.JanusOutcome.Janus_OK s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.MemRel js'.mem s' ∧ JanusASL.Proofs.LinuxEL0Config s'
STMT JanusASL.Proofs.step_agree : ∀ {w : Nat} {js spec : Janus.Arm64.State} {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → (∃ s2, EStateM.run (ArmASL.Functions.__DecodeA64 (↑(BitVec.toNat js.pc)) (BitVec.ofNat 32 w)) (JanusASL.Proofs.stepEntry s (BitVec.ofNat 32 w)) = EStateM.Result.ok () s2 ∧ JanusASL.Proofs.Rel spec s2 ∧ s2.regs.get? ArmASL.Register.__BranchTaken = Option.some Bool.false ∧ JanusASL.Proofs.CfgFrame s s2) → spec.pc = js.pc → Janus.Arm64.step w js = Except.ok { regs := spec.regs, sp := spec.sp, pc := js.pc + 4, flags := spec.flags, mem := spec.mem, dczid := spec.dczid, vregs := spec.vregs, tpidr := spec.tpidr } → ∃ js' s', Janus.Arm64.step w js = Except.ok js' ∧ EStateM.run (ArmASL.Functions.janus_step (BitVec.ofNat 32 w)) s = EStateM.Result.ok ArmASL.JanusOutcome.Janus_OK s' ∧ JanusASL.Proofs.Rel js' s' ∧ (JanusASL.Proofs.LinuxEL0Config s → JanusASL.Proofs.LinuxEL0Config s')
STMT JanusASL.Proofs.run_agree : ∀ (p : Janus.Program), (∀ (pc w : Nat), p.fetch pc = Option.some w → JanusASL.Proofs.StepOK w) → JanusASL.Proofs.Untagged p → ∀ (fuel : Nat) (js : Janus.Arm64.State) (s : JanusASL.Proofs.SState) (o : Janus.Outcome), JanusASL.Proofs.Rel js s → JanusASL.Proofs.LinuxEL0Config s → p.run fuel js = Except.ok o → JanusASL.Proofs.OutcomeRel o (JanusASL.Proofs.aslRun p fuel s)
STMT JanusASL.Proofs.Ensures.toASL : ∀ {p : Janus.Program} {entry : Nat} {args : List Janus.Arm64.W64} {pre : Janus.Arm64.State → Prop} {post : Janus.Arm64.State → Janus.Arm64.State → Prop}, Janus.GoABI.Ensures p entry args pre post → (∀ (w : Nat), w ∈ List.flatMap (fun x => x.words) p.segments → JanusASL.Proofs.StepOK w) → (∀ (seg : Janus.Segment), seg ∈ p.segments → seg.base + 4 * seg.words.length < 2 ^ 56) → (∀ (st : Janus.Stub), st ∈ p.stubs → st.addr < 2 ^ 56) → ∀ {ret : Nat}, Janus.GoABI.RetAddr p ret → ∀ {js : Janus.Arm64.State}, Janus.GoABI.CallSetup (p.withExit ret) entry args js → pre js → ∀ {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.LinuxEL0Config s → ∃ fuel s' js', JanusASL.Proofs.aslRun (p.withExit ret) fuel s = JanusASL.Proofs.AslOutcome.returned s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.LinuxEL0Config s' ∧ Janus.GoABI.ABIReturn js js' ∧ post js js'
STMT JanusASL.Proofs.StepOK.of_agree : ∀ {w : Nat}, (∀ (js : Janus.Arm64.State) (s : JanusASL.Proofs.SState), JanusASL.Proofs.Rel js s → ∃ js' s', Janus.Arm64.step w js = Except.ok js' ∧ EStateM.run (ArmASL.Functions.janus_step (BitVec.ofNat 32 w)) s = EStateM.Result.ok ArmASL.JanusOutcome.Janus_OK s' ∧ JanusASL.Proofs.Rel js' s' ∧ (JanusASL.Proofs.LinuxEL0Config s → JanusASL.Proofs.LinuxEL0Config s')) → JanusASL.Proofs.StepOK w
STMT JanusASL.Examples.Add.correctness_asl : ∀ (x y : BitVec 64) {ret : Nat}, Janus.GoABI.RetAddr JanusASL.Examples.Add.program ret → ∀ {js : Janus.Arm64.State}, Janus.GoABI.CallSetup (JanusASL.Examples.Add.program.withExit ret) JanusASL.Examples.Add.entry [x, y] js → ∀ {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.LinuxEL0Config s → ∃ fuel s' js', JanusASL.Proofs.aslRun (JanusASL.Examples.Add.program.withExit ret) fuel s = JanusASL.Proofs.AslOutcome.returned s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.LinuxEL0Config s' ∧ Janus.GoABI.ABIReturn js js' ∧ BitVec.toNat (js'.regs 0) = (x.toNat + y.toNat) % 2 ^ 64
STMT JanusASL.Examples.Max.correctness_asl : ∀ (x y : BitVec 64) {ret : Nat}, Janus.GoABI.RetAddr JanusASL.Examples.Max.program ret → ∀ {js : Janus.Arm64.State}, Janus.GoABI.CallSetup (JanusASL.Examples.Max.program.withExit ret) JanusASL.Examples.Max.entry [x, y] js → ∀ {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.LinuxEL0Config s → ∃ fuel s' js', JanusASL.Proofs.aslRun (JanusASL.Examples.Max.program.withExit ret) fuel s = JanusASL.Proofs.AslOutcome.returned s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.LinuxEL0Config s' ∧ Janus.GoABI.ABIReturn js js' ∧ js'.regs 0 = if y.toNat < x.toNat then x else y
STMT JanusASL.Examples.Mul64.correctness_asl : ∀ (x y : BitVec 64) {ret : Nat}, Janus.GoABI.RetAddr JanusASL.Examples.Mul64.program ret → ∀ {js : Janus.Arm64.State}, Janus.GoABI.CallSetup (JanusASL.Examples.Mul64.program.withExit ret) JanusASL.Examples.Mul64.entry [x, y] js → ∀ {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.LinuxEL0Config s → ∃ fuel s' js', JanusASL.Proofs.aslRun (JanusASL.Examples.Mul64.program.withExit ret) fuel s = JanusASL.Proofs.AslOutcome.returned s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.LinuxEL0Config s' ∧ Janus.GoABI.ABIReturn js js' ∧ BitVec.toNat (js'.regs 0) * 2 ^ 64 + BitVec.toNat (js'.regs 1) = x.toNat * y.toNat
STMT JanusASL.Examples.Add128.correctness_asl : ∀ (xh xl yh yl : BitVec 64) {ret : Nat}, Janus.GoABI.RetAddr JanusASL.Examples.Add128.program ret → ∀ {js : Janus.Arm64.State}, Janus.GoABI.CallSetup (JanusASL.Examples.Add128.program.withExit ret) JanusASL.Examples.Add128.entry [xh, xl, yh, yl] js → ∀ {s : JanusASL.Proofs.SState}, JanusASL.Proofs.Rel js s → JanusASL.Proofs.LinuxEL0Config s → ∃ fuel s' js', JanusASL.Proofs.aslRun (JanusASL.Examples.Add128.program.withExit ret) fuel s = JanusASL.Proofs.AslOutcome.returned s' ∧ JanusASL.Proofs.Rel js' s' ∧ JanusASL.Proofs.LinuxEL0Config s' ∧ Janus.GoABI.ABIReturn js js' ∧ BitVec.toNat (js'.regs 0) * 2 ^ 64 + BitVec.toNat (js'.regs 1) = (xh.toNat * 2 ^ 64 + xl.toNat + (yh.toNat * 2 ^ 64 + yl.toNat)) % 2 ^ 128
