    ∃ out und, (shrd_spec_64 x y (BitVec.ofNat 6 c) rin).run s = .ok (shdVal false x y c, false, out, und) s ∧
      FlagsRel (shdFl false x y c f) df (wurf rin out und u) := by
  have hz : ∀ g : BitVec 32 → BitVec 1, (g (Mk_rflagsbits 0#32) == 1#1) = (g 0#32 == 1#1) := fun _ => rfl
  have hsf : ∀ r : BitVec 64, BitVec.ofBool (decide (2 ^ 63 ≤ r.toNat)) = BitVec.ofBool r.msb := fun r => by
    rw [BitVec.msb_eq_decide]
  have hmsb : ∀ r : BitVec 64, r.getLsbD 63 = r.msb := fun r => by rw [BitVec.msb_eq_getLsbD_last]
  have hn : (bits_of_int (Neg.neg (Sail.BitVec.toNatInt (BitVec.ofNat 6 c))) 65).toInt = -(c : Int) :=
    neg6 64 c hc (by decide)
  have hv : bits_of_int (ash_int (Sail.BitVec.toNatInt (bits_of_int (ash_left_int (Sail.BitVec.toNatInt y) 64) 128 |||
      Sail.BitVec.zeroExtend x 128)) (bits_of_int (Neg.neg (Sail.BitVec.toNatInt (BitVec.ofNat 6 c))) 65).toInt) 64 =
      shdVal false x y c := by
    rw [concat_val 64 128 rfl, hn]
    exact shrd_val 64 c _ rfl
  have hgt : ((Sail.BitVec.toNatInt (BitVec.ofNat 6 c)) >b 64) = false := by
    rw [toNatInt_ofNat6 c hc]; simp; omega
  have hle : ((Sail.BitVec.toNatInt (BitVec.ofNat 6 c)) ≤b 64) = true := by
    rw [toNatInt_ofNat6 c hc]; simp; omega
  simp only [shrd_spec_64, eqb6 c _ hc, run_bind, run_pure, hv, hgt, hle]
  by_cases h0 : c = 0
  · have hd : decide (c = 0) = true := by simp [h0]
    simp only [hd, ↓reduceIte, run_pure]
    refine ⟨_, _, rfl, ?_⟩
    simp only [shdFl, h0, ↓reduceIte]
    refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    all_goals first
      | exact flagEq_none _
      | exact flagEq_some _
      | exact hr.cf | exact hr.pf | exact hr.af | exact hr.zf | exact hr.sf | exact hr.ovf
      | exact flagEq_bne _ _
      | (simp only [Option.map_some, zf_bv, hsf, Nat.reduceSub, hmsb]; first | exact flagEq_some _ | exact flagEq_bne _ _)
  have hd0 : decide (c = 0) = false := by simp [h0]
  by_cases h1 : c = 1
  · have hd1 : decide (c = 1) = true := by simp [h1]
    simp only [hd0, hd1, Bool.false_eq_true, ↓reduceIte, run_bind, run_pure, run_pf_spec64, Sail.BitVec.extractLsb, extractLsb_one_eq_ofBool, Nat.reduceSub, Nat.reduceAdd, BitVec.setWidth_eq, ofb_if, zf_spec_eq, sf_spec64_eq, logbit_eqI (w := 64) _ 63 (by decide) (by decide), Int.reduceToNat]
    refine ⟨_, _, rfl, ?_⟩
    simp only [shdFl, h0, h1, ↓reduceIte, Nat.reduceSub, hmsb]
    refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    all_goals first
      | exact flagEq_none _
      | exact flagEq_some _
      | exact hr.cf | exact hr.pf | exact hr.af | exact hr.zf | exact hr.sf | exact hr.ovf
      | exact flagEq_bne _ _
      | (simp only [Option.map_some, zf_bv, hsf, Nat.reduceSub, hmsb]; first | exact flagEq_some _ | exact flagEq_bne _ _)
  have hd1 : decide (c = 1) = false := by simp [h1]
  simp only [hd0, hd1, Bool.false_eq_true, ↓reduceIte, run_bind, run_pure, toNatInt_ofNat6 c hc,
    run_bitslice1 x ((c : Int) - 1) (by omega) (by omega), show ((c : Int) - 1).toNat = c - 1 by omega, run_pf_spec64, Sail.BitVec.extractLsb, extractLsb_one_eq_ofBool, Nat.reduceSub, Nat.reduceAdd, BitVec.setWidth_eq, ofb_if, zf_spec_eq, sf_spec64_eq, logbit_eqI (w := 64) _ 63 (by decide) (by decide), Int.reduceToNat]
  refine ⟨_, _, rfl, ?_⟩
  try simp only [shdFl, h0, h1, ↓reduceIte]
  refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
    ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
  all_goals first
    | exact flagEq_none _
    | exact flagEq_some _
    | exact hr.cf | exact hr.pf | exact hr.af | exact hr.zf | exact hr.sf | exact hr.ovf
    | exact flagEq_bne _ _
    | (simp only [Option.map_some, zf_bv, hsf, Nat.reduceSub, hmsb]; first | exact flagEq_some _ | exact flagEq_bne _ _)


