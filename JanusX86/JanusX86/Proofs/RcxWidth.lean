import JanusX86.Proofs.RcxSpec
import JanusX86.Proofs.ShiftSpec

/-! # Per-width RCL/RCR specifications (generated by JanusX86/tools/gen_rcxspec.py; do not edit)

For operand sizes 32 and 64 and masked count `c`: the model's `rcl_spec_w`/`rcr_spec_w` return
Janus' `execRcx` value (`rcxVal`) and flags related to Janus' (`rcxFl`), given Janus' `CF` (`b`)
when the count is not 0. -/

set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000

namespace JanusX86.Proofs
open X86Sail X86Sail.Functions
open Janus.Amd64

theorem run_bxor_bind {β : Type} (a b : Bool) (k : Int → SailM β) (s : SState) :
    (b_xor (Sail.BitVec.toNatInt (BitVec.ofBool a)) (Sail.BitVec.toNatInt (BitVec.ofBool b)) >>= k).run s =
      (k (if a != b then 1 else 0)).run s := by
  rw [run_bind, run_b_xor]

theorem run_rcl32 (x : BitVec 32) (c : Nat) (hc : c < 64) (hcw : c < 33) (rin : BitVec 32) (s : SState)
    (f : Flags) (df : Bool) (u : Nat) (hr : FlagsRel f df rin) (b : Bool) (hb : c ≠ 0 → f.cf = some b) :
    ∃ out und, (rcl_spec_32 x (BitVec.ofNat 6 c) rin).run s = .ok (rcxVal true b x c, out, und) s ∧
      FlagsRel (rcxFl true b x c f) df (wurf rin out und u) := by
  have hz : ∀ g : BitVec 32 → BitVec 1, (g (Mk_rflagsbits 0#32) == 1#1) = (g 0#32 == 1#1) := fun _ => rfl
  have hmsb : ∀ r : BitVec 32, r.getLsbD 31 = r.msb := fun r => by rw [BitVec.msb_eq_getLsbD_last]
  simp only [rcl_spec_32]
  rw [ofBool_get0 (_get_rflagsbits_cf rin)]
  generalize hb' : (_get_rflagsbits_cf rin).getLsbD 0 = b'
  simp only [eqb6 c _ hc, run_bind, run_pure, chs_val 32 33 rfl, toNatInt_ofNat6 c hc,
    rotl_val (BitVec.ofNat 33 (b'.toNat * 2 ^ 32 + x.toNat)) 33 rfl c (by omega), Nat.mod_eq_of_lt (show c < 33 by omega)]
  by_cases h0 : c = 0
  · subst h0
    simp only [decide_true, ↓reduceIte, run_pure, rotl0, tr_ofNat_cat 32 33 rfl]
    refine ⟨_, _, rfl, ?_⟩
    simp only [rcxFl, ↓reduceIte]
    refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    all_goals first
      | exact flagEq_some _
      | exact flagEq_none _
      | exact hr.cf | exact hr.pf | exact hr.af | exact hr.zf | exact hr.sf | exact hr.ovf
      | exact flagEq_bne _ _
  have hbb : b' = b := by
    have := hr.cf b (hb h0); rw [← hb', this]; cases b <;> rfl
  subst hbb
  have hd0 : decide (c = 0) = false := by simp [h0]
  have hR : ∀ R : BitVec 33, Sail.BitVec.truncate R 32 = R.setWidth 32 := fun _ => rfl
  simp only [rcxFl, rcxVal, rcxR, h0, ↓reduceIte]
  generalize hT : BitVec.ofNat 65 (b'.toNat * 2 ^ 32 + x.toNat) = T
  simp only [hd0, Bool.false_eq_true, ↓reduceIte, hR, logbit_eqI (w := 33) _ 32 (by decide) (by decide),
    logbit_eqI (w := 32) _ 31 (by decide) (by decide), Int.reduceToNat, hmsb]
  by_cases h1 : c = 1
  · have hd1 : decide (c = 1) = true := decide_eq_true h1
    simp only [hd1, hd0, decide_false, Bool.false_eq_true, ↓reduceIte]
    rw [run_bxor_bind]
    simp only [run_pure, bits1_xor]
    refine ⟨_, _, rfl, ?_⟩
    simp only [h1, ↓reduceIte]
    refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
        rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
        rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
        rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
        rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
        rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    · exact flagEq_some _
    · exact hr.pf
    · exact hr.af
    · exact hr.zf
    · exact hr.sf
    · exact flagEq_bne _ _
  have hd1 : decide (c = 1) = false := by simp [h1]
  simp only [h1, decide_false, Bool.false_eq_true, ↓reduceIte, run_pure]
  refine ⟨_, _, rfl, ?_⟩
  refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
    ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
  · exact flagEq_some _
  · exact hr.pf
  · exact hr.af
  · exact hr.zf
  · exact hr.sf
  · exact flagEq_none _


