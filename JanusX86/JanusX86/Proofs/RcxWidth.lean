    rotr_val (BitVec.ofNat 33 (b'.toNat * 2 ^ 32 + x.toNat)) 33 rfl c (by omega), Nat.mod_eq_of_lt (show c < 33 by omega)]
  by_cases h0 : c = 0
  · subst h0
    simp only [decide_true, ↓reduceIte, run_pure, rotr0, tr_ofNat_cat 32 33 rfl]
    refine ⟨_, _, rfl, ?_⟩
