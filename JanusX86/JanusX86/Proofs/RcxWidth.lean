    ∃ out und, (rcr_spec_32 x (BitVec.ofNat 6 c) rin).run s = .ok (rcxVal false b x c, out, und) s ∧
      FlagsRel (rcxFl false b x c f) df (wurf rin out und u) := by
  have hz : ∀ g : BitVec 32 → BitVec 1, (g (Mk_rflagsbits 0#32) == 1#1) = (g 0#32 == 1#1) := fun _ => rfl
