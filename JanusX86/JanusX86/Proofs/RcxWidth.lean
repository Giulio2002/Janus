theorem run_rcr64 (x : BitVec 64) (c : Nat) (hc : c < 64) (hcw : c < 65) (rin : BitVec 32) (s : SState)
    (f : Flags) (df : Bool) (u : Nat) (hr : FlagsRel f df rin) (b : Bool) (hb : c ≠ 0 → f.cf = some b) :
    ∃ out und, (rcr_spec_64 x (BitVec.ofNat 6 c) rin).run s = .ok (rcxVal false b x c, out, und) s ∧
      FlagsRel (rcxFl false b x c f) df (wurf rin out und u) := by
  have hz : ∀ g : BitVec 32 → BitVec 1, (g (Mk_rflagsbits 0#32) == 1#1) = (g 0#32 == 1#1) := fun _ => rfl
  have hmsb : ∀ r : BitVec 64, r.getLsbD 63 = r.msb := fun r => by rw [BitVec.msb_eq_getLsbD_last]
  simp only [rcr_spec_64]
  rw [ofBool_get0 (_get_rflagsbits_cf rin)]
  generalize hb' : (_get_rflagsbits_cf rin).getLsbD 0 = b'
  simp only [eqb6 c _ hc, run_bind, run_pure, chs_val 64 65 rfl, toNatInt_ofNat6 c hc,
    rotr_val (BitVec.ofNat 65 (b'.toNat * 2 ^ 64 + x.toNat)) 65 rfl c (by omega), Nat.mod_eq_of_lt (show c < 65 by omega)]
  by_cases h0 : c = 0
  · subst h0
    simp only [decide_true, ↓reduceIte, run_pure, rotr0, tr_ofNat_cat 64 65 rfl]
    refine ⟨_, _, rfl, ?_⟩
    simp only [rcxFl, ↓reduceIte]
    refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    all_goals first
      | exact flagEq_some _
      | exact flagEq_none _
      | exact hr.cf | exact hr.pf | exact hr.af | exact hr.zf | exact hr.sf | exact hr.ovf
      | exact flagEq_bne _ _
  have hbb : b' = b := by
    have := hr.cf b (hb h0); rw [← hb', this]; cases b <;> rfl
  subst hbb
  have hd0 : decide (c = 0) = false := by simp [h0]
  have hR : ∀ R : BitVec 65, Sail.BitVec.truncate R 64 = R.setWidth 64 := fun _ => rfl
  have hr2 : c = 1 → (BitVec.setWidth 64 ((BitVec.ofNat 65 (b'.toNat * 2 ^ 64 + x.toNat)).rotateRight c)).msb = b' ∧
      (BitVec.setWidth 64 ((BitVec.ofNat 65 (b'.toNat * 2 ^ 64 + x.toNat)).rotateRight c)).getLsbD 62 = x.msb := by
    intro h; subst h
    simp only [ofNat_cat, BitVec.msb_eq_getLsbD_last, BitVec.getLsbD_setWidth, BitVec.getLsbD_rotateRight,
      BitVec.getLsbD_cast, BitVec.getLsbD_append]
    simp
  simp only [rcxFl, rcxVal, rcxR, h0, ↓reduceIte]
  generalize hT : BitVec.ofNat 65 (b'.toNat * 2 ^ 64 + x.toNat) = T at hr2 ⊢
  simp only [hd0, Bool.false_eq_true, ↓reduceIte, hR, logbit_eqI (w := 65) _ 64 (by decide) (by decide),
    logbit_eqI (w := 64) _ 63 (by decide) (by decide), Int.reduceToNat, hmsb, Sail.BitVec.extractLsb, extractLsb_one_eq_ofBool, Nat.reduceSub, Nat.reduceAdd, BitVec.setWidth_eq]
  by_cases h1 : c = 1
  · have hd1 : decide (c = 1) = true := decide_eq_true h1
    simp only [hd1, hd0, decide_false, Bool.false_eq_true, ↓reduceIte]
    rw [run_bxor_bind]
    simp only [run_pure, bits1_xor]
    refine ⟨_, _, rfl, ?_⟩
    obtain ⟨e1, e2⟩ := hr2 h1
    simp only [e1, e2]
    simp only [h1, ↓reduceIte]
    refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
        rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
        rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
        rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
        rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
        rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    · exact flagEq_some _
    · exact hr.pf
    · exact hr.af
    · exact hr.zf
    · exact hr.sf
    · exact flagEq_bne _ _
  have hd1 : decide (c = 1) = false := by simp [h1]
  simp only [h1, decide_false, Bool.false_eq_true, ↓reduceIte, run_pure]
  refine ⟨_, _, rfl, ?_⟩
  refine flagsRel_wurf hr _ _ _ u ?_ ?_ ?_ ?_ ?_ ?_ <;> simp (config := {decide := true}) only [Bool.false_eq_true,
    ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
  · exact flagEq_some _
  · exact hr.pf
  · exact hr.af
  · exact hr.zf
  · exact hr.sf
