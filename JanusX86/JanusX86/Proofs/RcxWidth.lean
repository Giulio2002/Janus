      ↓reduceIte, hz, rf_get_cf_upd_cf, rf_get_cf_upd_pf, rf_get_cf_upd_af, rf_get_cf_upd_zf, rf_get_cf_upd_sf, rf_get_cf_upd_of,
      rf_get_pf_upd_cf, rf_get_pf_upd_pf, rf_get_pf_upd_af, rf_get_pf_upd_zf, rf_get_pf_upd_sf, rf_get_pf_upd_of,
      rf_get_af_upd_cf, rf_get_af_upd_pf, rf_get_af_upd_af, rf_get_af_upd_zf, rf_get_af_upd_sf, rf_get_af_upd_of,
      rf_get_zf_upd_cf, rf_get_zf_upd_pf, rf_get_zf_upd_af, rf_get_zf_upd_zf, rf_get_zf_upd_sf, rf_get_zf_upd_of,
      rf_get_sf_upd_cf, rf_get_sf_upd_pf, rf_get_sf_upd_af, rf_get_sf_upd_zf, rf_get_sf_upd_sf, rf_get_sf_upd_of,
      rf_get_of_upd_cf, rf_get_of_upd_pf, rf_get_of_upd_af, rf_get_of_upd_zf, rf_get_of_upd_sf, rf_get_of_upd_of]
    all_goals first
      | exact flagEq_some _
      | exact flagEq_none _
      | exact hr.cf | exact hr.pf | exact hr.af | exact hr.zf | exact hr.sf | exact hr.ovf
      | exact flagEq_bne _ _
  have hbb : b' = b := by
    have := hr.cf b (hb h0); rw [← hb', this]; cases b <;> rfl
  subst hbb
  have hd0 : decide (c = 0) = false := by simp [h0]
  have hR : ∀ R : BitVec 33, Sail.BitVec.truncate R 32 = R.setWidth 32 := fun _ => rfl
  have hr2 : c = 1 → (BitVec.setWidth 32 ((BitVec.ofNat 33 (b'.toNat * 2 ^ 32 + x.toNat)).rotateRight c)).msb = b' ∧
      (BitVec.setWidth 32 ((BitVec.ofNat 33 (b'.toNat * 2 ^ 32 + x.toNat)).rotateRight c)).getLsbD 30 = x.msb := by
    intro h; subst h
    simp only [ofNat_cat, BitVec.msb_eq_getLsbD_last, BitVec.getLsbD_setWidth, BitVec.getLsbD_rotateRight,
      BitVec.getLsbD_cast, BitVec.getLsbD_append]
    simp
  simp only [rcxFl, rcxVal, rcxR, h0, ↓reduceIte]
  generalize hT : BitVec.ofNat 65 (b'.toNat * 2 ^ 32 + x.toNat) = T at hr2 ⊢
  simp only [hd0, Bool.false_eq_true, ↓reduceIte, hR, logbit_eqI (w := 33) _ 32 (by decide) (by decide),
    logbit_eqI (w := 32) _ 31 (by decide) (by decide), Int.reduceToNat, hmsb, Sail.BitVec.extractLsb, extractLsb_one_eq_ofBool, Nat.reduceSub, Nat.reduceAdd, BitVec.setWidth_eq]
  by_cases h1 : c = 1
  · have hd1 : decide (c = 1) = true := decide_eq_true h1
    simp only [hd1, hd0, decide_false, Bool.false_eq_true, ↓reduceIte]
