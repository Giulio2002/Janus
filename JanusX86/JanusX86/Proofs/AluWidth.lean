import JanusX86.Proofs.AluSpec

/-! # Per-width ALU specifications (generated by JanusX86/tools/gen_aluspec.py; do not edit)

For each operand size `w ∈ {8, 16, 32, 64}` (the model's `_1`/`_2`/`_4`/`_8` and `…8`/`…16`/`…32`/`…64`
functions): the flag helpers as closed formulas, then `gpr_add/adc/sub/sbb/and/or/xor_spec` as
Janus' `addFlags`/`subFlags`/`logicFlags`. -/

set_option linter.unusedSimpArgs false

namespace JanusX86.Proofs
open X86Sail X86Sail.Functions


/-! ## 8-bit -/

theorem ipow_8 : (2 : Int) ^ (8 : Int) = ((256 : Nat) : Int) := by decide +kernel
theorem ipow_8m : (2 : Int) ^ ((8 : Int) - 1) = ((128 : Nat) : Int) := by decide +kernel

theorem run_cf_spec8 (v : BitVec 9) (s : SState) :
    (cf_spec8 v).run s = .ok (BitVec.ofBool (decide (v.toNat ≥ 2 ^ 8))) s := by
  simp only [cf_spec8, unsigned_byte_p_int, run_bind,
    run_sail_assert_of (show decide ((8 : Int) ≥ 0) = true by decide), run_pure, ipow_8]
  refine congrArg (EStateM.Result.ok · s) (bool_to_bits_of _ _ ?_)
  generalize hx : Sail.BitVec.toNatInt v = X
  have : X = v.toNat := by rw [← hx]; rfl
  subst this
  (rw [Bool.eq_iff_iff]; simp) <;> omega

theorem run_of_spec8 (v : BitVec 9) (s : SState) :
    (of_spec8 v).run s = .ok (BitVec.ofBool (decide ¬(-(2 ^ 7 : Int) ≤ v.toInt ∧ v.toInt < 2 ^ 7))) s := by
  simp only [of_spec8, signed_byte_p_int, run_bind,
    run_sail_assert_of (show decide ((8 : Int) ≥ 0) = true by decide), run_pure, ipow_8m]
  refine congrArg (EStateM.Result.ok · s) (bool_to_bits_of _ _ ?_)
  generalize v.toInt = X
  (rw [Bool.eq_iff_iff]; simp) <;> omega

theorem run_pf_spec8 (r : BitVec 8) (s : SState) :
    (pf_spec8 r).run s = .ok (BitVec.ofBool (Janus.Amd64.parity r.toNat)) s := by
  have hl : (Sail.BitVec.toNatInt (r)) = ((r.toNat % 256 : Nat) : Int) := by
    simp [Sail.BitVec.toNatInt]; omega
  simp only [pf_spec8, hl]
  rw [pf_eq _ (by omega), parity_mod256]

theorem sf_spec8_eq (r : BitVec 8) : sf_spec8 r = BitVec.ofBool (decide (2 ^ 7 ≤ r.toNat)) := by
  simp only [sf_spec8, Sail.BitVec.extractLsb, extractLsb_one_eq_ofBool, BitVec.setWidth_eq]
  apply congrArg BitVec.ofBool
  rw [show r.getLsbD 7 = r.getLsbD (8 - 1) from rfl, ← BitVec.msb_eq_getLsbD_last, BitVec.msb_eq_decide]


