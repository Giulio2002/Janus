/-! ## 8-bit specifications -/

theorem add_af_spec8_eq (x y : BitVec 8) :
    add_af_spec8 x y = BitVec.ofBool (decide (x.toNat % 16 + y.toNat % 16 > 15)) := by
  simp only [add_af_spec8, toNatInt_extract30]
  exact bool_to_bits_of _ _ (af_add_gen _ _ (by omega) (by omega))

theorem sub_af_spec8_eq (x y : BitVec 8) :
    sub_af_spec8 x y = BitVec.ofBool (decide (x.toNat % 16 < y.toNat % 16)) := by
  simp only [sub_af_spec8, toNatInt_extract30]
  exact bool_to_bits_of _ _ (af_sub_gen _ _ (by omega) (by omega))

theorem adc_af_spec8_eq (x y : BitVec 8) (c : Bool) :
    adc_af_spec8 x y (BitVec.ofBool c) = BitVec.ofBool (decide (x.toNat % 16 + y.toNat % 16 + c.toNat > 15)) := by
  simp only [adc_af_spec8, toNatInt_extract30]
  have : Sail.BitVec.toNatInt (BitVec.ofBool c) = ((c.toNat : Nat) : Int) := by cases c <;> rfl
  rw [this]
  exact bool_to_bits_of _ _ (af_adc_gen _ _ _ (by omega) (by omega) (by cases c <;> decide))

theorem sbb_af_spec8_eq (x y : BitVec 8) (c : Bool) :
    sbb_af_spec8 x y (BitVec.ofBool c) = BitVec.ofBool (decide (x.toNat % 16 < y.toNat % 16 + c.toNat)) := by
  simp only [sbb_af_spec8, toNatInt_extract30]
  have : Sail.BitVec.toNatInt (Sail.BitVec.zeroExtend (BitVec.ofBool c) 4) = ((c.toNat : Nat) : Int) := by
    cases c <;> rfl
  rw [this]
  exact bool_to_bits_of _ _ (af_sbb_gen _ _ _)

