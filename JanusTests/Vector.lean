import Janus.Arm64.Exec
import JanusTests.Exec

/-!
# Advanced SIMD and SIMD&FP loads/stores on concrete states

Generated like `JanusTests/Exec.lean` (by a script that runs each word under `qemu-aarch64` with
the oracle runner): every `example` is a hardware-vs-model agreement check re-checked by the
kernel. The initial state is `JanusTests.Exec.st` plus `V[i]` = the bytes `16i .. 16i+15`
(`vdef`) unless overridden, and TPIDR_EL0 = `0x7766554433221100`. `obsV` observes `X0..X30`,
`pc`, `V0..V31` and the listed data bytes.
-/

namespace JanusTests.Vector
open Janus.Arm64 JanusTests.Exec

def vdef (i : Nat) : Nat :=
  (0x0706050403020100 + 0x0808080808080808 * (2 * i)) % 2 ^ 64 +
    2 ^ 64 * ((0x0f0e0d0c0b0a0908 + 0x0808080808080808 * (2 * i)) % 2 ^ 64)

def lookupV (ov : List (Nat × Nat)) (i : Nat) : Nat :=
  match ov.find? (·.1 == i) with
  | some (_, v) => v
  | none => vdef i

def stv (ov vov : List (Nat × Nat)) : State :=
  { st ov (dataBase + 0x800) 0 with
    vregs := fun i => BitVec.ofNat 128 (lookupV vov i), tpidr := 0x7766554433221100 }

def obsV (r : Except Fault State) (offs : List Nat) :
    Option (List Nat × Nat × List Nat × List Nat) :=
  match r with
  | .ok s => some ((List.range 31).map (fun i => (s.regs i).toNat), s.pc.toNat,
      (List.range 32).map (fun i => (s.vregs i).toNat), offs.map fun o => (s.mem.bytes (dataBase + o)).toNat)
  | .error _ => none

