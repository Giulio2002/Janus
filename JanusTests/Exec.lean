import Janus.Arm64.Exec

/-!
# Executor tests on concrete states

The expected results below were produced by running each instruction under `qemu-aarch64`
with the oracle runner (`oracle/bin/runner`) from the same initial state, so every
`example` is a hardware-vs-model agreement check, re-checked by the Lean kernel (`decide`).

Initial state (`st overrides sp nzcv`): `X[i] = (i + 1) * 0x0123456789ABCDEF mod 2^64` unless
overridden, `pc = 0x1000000800`, and one writable 4096-byte allocation at `dataBase` whose
byte `i` is `(i * 157 + (i / 256) * 41 + 7) % 256` (the oracle's pattern with seed 0).
`obs r offs` observes `X0..X30`, `SP`, `pc`, `NZCV` and the data bytes at offsets `offs`.
-/

namespace JanusTests.Exec
open Janus.Arm64

def dataBase : Nat := 0x10_0000_0000 + 0x4_0000

def pattern (i : Nat) : Nat := (i * 157 + (i / 256) * 41 + 7) % 256

def lookupReg (ov : List (Nat × Nat)) (i : Nat) : Nat :=
  match ov.find? (·.1 == i) with
  | some (_, v) => v
  | none => (i + 1) * 0x0123456789ABCDEF % 2 ^ 64

def st (ov : List (Nat × Nat)) (sp nzcv : Nat) : State :=
  { regs := fun i => BitVec.ofNat 64 (lookupReg ov i)
    sp := BitVec.ofNat 64 sp
    pc := BitVec.ofNat 64 0x1000000800
    flags := ⟨nzcv / 8 % 2 == 1, nzcv / 4 % 2 == 1, nzcv / 2 % 2 == 1, nzcv % 2 == 1⟩
    mem := ⟨fun a => if dataBase ≤ a ∧ a < dataBase + 4096 then BitVec.ofNat 8 (pattern (a - dataBase))
                     else 0, [⟨dataBase, 4096, true⟩]⟩ }

def nzcvOf (f : Flags) : Nat :=
  (if f.n then 8 else 0) + (if f.z then 4 else 0) + (if f.c then 2 else 0) + (if f.v then 1 else 0)

def obs (r : Except Fault State) (offs : List Nat) :
    Option (List Nat × Nat × Nat × Nat × List Nat) :=
  match r with
  | .ok s => some ((List.range 31).map (fun i => (s.regs i).toNat), s.sp.toNat, s.pc.toNat,
      nzcvOf s.flags, offs.map fun o => (s.mem.bytes (dataBase + o)).toNat)
  | .error _ => none

def faultOf (r : Except Fault State) : Option Fault :=
  match r with
  | .ok _ => none
  | .error e => some e

