/-! ## Faults the oracle cannot observe under qemu-user

qemu-user does not enforce SCTLR_EL1.SA0, and reports a misaligned indirect branch only at the
next fetch; the model faults at the instruction itself. -/

-- ldr x0, [sp, #8] with SP = 8 (mod 16)
example : faultOf (step 0xf94007e0 (st [] 0x1000040808 0)) = some (.spMisaligned 0x1000040808) := by decide
-- str x0, [sp, #-16]! with SP = 4 (mod 16)
example : faultOf (step 0xf81f0fe0 (st [] 0x1000040804 0)) = some (.spMisaligned 0x1000040804) := by decide
-- stp x29, x30, [sp, #-32]! with misaligned SP
example : faultOf (step 0xa9be7bfd (st [] 0x1000040801 0)) = some (.spMisaligned 0x1000040801) := by decide
-- add sp, sp, #4 is not an access: no alignment check
example : faultOf (step 0x910013ff (st [] 0x1000040808 0)) = none := by decide
-- ldr x0, [x1] with an unaligned X1 inside the allocation is fine (no alignment check on Xn)
example : faultOf (step 0xf9400020 (st [(1, 0x1000040001)] 0x1000040800 0)) = none := by decide
-- br x1 / blr x1 / ret to targets with low bits set
example : faultOf (step 0xd61f0020 (st [(1, 0x1000000842)] 0x1000040800 0)) = some (.pcMisaligned 0x1000000842) := by decide
example : faultOf (step 0xd63f0020 (st [(1, 0x1000000841)] 0x1000040800 0)) = some (.pcMisaligned 0x1000000841) := by decide
example : faultOf (step 0xd65f03c0 (st [(30, 0x1000000813)] 0x1000040800 0)) = some (.pcMisaligned 0x1000000813) := by decide
-- stores into a read-only allocation
example : faultOf (step 0xf9000020 { st [(1, 0x1000040000)] 0x1000040800 0 with
    mem := ⟨fun _ => 0, [⟨0x1000040000, 16, false⟩]⟩ }) = some (.readOnly 0x1000040000 8) := by decide
-- an unsupported word
example : faultOf (step 0xd4000001 (st [] 0x1000040800 0)) = some (.undecodable 0x1000000800 0xd4000001) := by decide
-- b .-0x8000000 from pc 0: the target wraps modulo 2^64
example : (obs (step 0x16000000 { st [] 0 0 with pc := 0 }) []).map (·.2.2.1) = some (2 ^ 64 - 0x8000000) := by
  decide

end JanusTests.Exec
