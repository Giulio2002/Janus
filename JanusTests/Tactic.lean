/-! ## Branches and a panic stub

`cbz x1, L; udiv x0, x0, x1; ret; L: bl panicdivide` (stub at `0x2100c`). -/

def divp : Program where
  segments := [{ name := "div", base := 0x20000, words := [0xb4000061, 0x9ac10800, 0xd65f03c0, 0x94000400] }]
  stubs := [{ name := "runtime.panicdivide", addr := 0x2100c, kind := .panic }]
  exitAddr := 0

theorem div_returns (x y : W64) :
    Ensures divp 0x20000 [x, y] (fun _ => y.toNat ≠ 0)
      (fun _ s' => (s'.regs 0).toNat = x.toNat / y.toNat) := by
  intro ret hret s hs hy
  janus_intro hs
  janus_run [hy]

theorem div_panics (x : W64) (ret : Nat) (hret : RetAddr divp ret) (s : State)
    (hs : CallSetup (divp.withExit ret) 0x20000 [x, 0#64] s) :
    Panics (divp.withExit ret) s := by
  janus_intro hs
  janus_run

/-! ## Memory with aliasing

`swap(p, q *uint64)`: `ldr x2,[x0]; ldr x3,[x1]; str x3,[x0]; str x2,[x1]; ret`. The pointers may
be equal (then nothing changes) or disjoint. -/

def swapp : Program where
  segments := [{ name := "swap", base := 0x30000, words := [0xf9400002, 0xf9400023, 0xf9000003, 0xf9000022, 0xd65f03c0] }]
  stubs := []
  exitAddr := 0

theorem swap_spec (p q : W64) :
    Ensures swapp 0x30000 [p, q]
      (fun s => Ptr s.mem p 8 true ∧ Ptr s.mem q 8 true ∧ (p = q ∨ Disjoint p.toNat 8 q.toNat 8))
      (fun s s' => s'.mem.readLE p.toNat 8 = s.mem.readLE q.toNat 8 ∧
        s'.mem.readLE q.toNat 8 = s.mem.readLE p.toNat 8) := by
  intro ret hret s hs ⟨⟨hp, hp'⟩, ⟨hq, hq'⟩, hpq⟩
  janus_intro hs
  rcases hpq with rfl | hpq
  · janus_run
  · simp only [Disjoint] at hpq
    janus_run

/-! ## Read-only data

`and x1, x0, #3; adrp x2, page; add x2, x2, #0x100; ldr x0, [x2, x1, lsl #3]; ret` with a
4-word table at `0x40100`. -/

def tablep : Program where
  segments := [{ name := "table", base := 0x40000, words := [0x92400401, 0x90000002, 0x91040042, 0xf8617840, 0xd65f03c0] }]
  stubs := []
  exitAddr := 0
  data := [{ name := ".rodata", base := 0x40100, bytes := [
    1, 0, 0, 0, 0, 0, 0, 0,  2, 0, 0, 0, 0, 0, 0, 0,  3, 0, 0, 0, 0, 0, 0, 0,  0xff, 0, 0, 0, 0, 0, 0, 0] }]

theorem table_spec (i : W64) :
    Ensures tablep 0x40000 [i] (fun s => tablep.DataLoaded s.mem)
      (fun _ s' => (s'.regs 0).toNat = [1, 2, 3, 255][i.toNat % 4]!) := by
  intro ret hret s hs hd
  janus_intro hs
  janus_data hd
  janus_run
  generalize hk : i.toNat % 4 = k
  have hlt : k < 4 := hk ▸ Nat.mod_lt _ (by decide)
  janus_cases hlt
  all_goals janus_simp

/-! ## Calls through a callee summary

`f: str x30,[sp,#-16]!; bl g; bl g; ldr x30,[sp],#16; ret` and `g: add x0, x0, #1; ret`. -/

def callp : Program where
  segments := [{ name := "f", base := 0x50000, words := [0xf81f0ffe, 0x94000004, 0x94000003, 0xf84107fe, 0xd65f03c0, 0x91000400, 0xd65f03c0] }]
  stubs := []
  exitAddr := 0

theorem g_summary :
    Summary callp 0x50014 (fun s => (s.regs 30).toNat % 4 = 0 ∧ (s.regs 30).toNat < 2 ^ 56)
      (fun s s' => s' = { s with regs := setReg s.regs 0 (s.regs 0 + 1#64), pc := s.regs 30 }) := by
  intro s hpc ⟨h1, h2⟩
  janus_run

theorem call_spec (x : W64) :
    Ensures callp 0x50000 [x] (fun s => StackOK s 16 0)
      (fun _ s' => (s'.regs 0).toNat = (x.toNat + 2) % 2 ^ 64) := by
  intro ret hret s hs ⟨hal, hb, ha, hw⟩
  janus_intro hs
  janus_run calls [g_summary]
  all_goals janus_arith

/-- Without the summary, the callee is simply executed inline. -/
theorem call_spec_inline (x : W64) :
    Ensures callp 0x50000 [x] (fun s => StackOK s 16 0)
      (fun _ s' => (s'.regs 0).toNat = (x.toNat + 2) % 2 ^ 64) := by
  intro ret hret s hs ⟨hal, hb, ha, hw⟩
  janus_intro hs
  janus_run
  all_goals janus_arith

/-! ## A loop with an invariant

`mov x1, xzr; cbz x0, done; L: add x1, x1, #2; subs x0, x0, #1; b.ne L; done: mov x0, x1; ret`
returns `2·x0`. -/

def loopp : Program where
  segments := [{ name := "loop", base := 0x60000, words := [0xaa1f03e1, 0xb4000080, 0x91000821, 0xf1000400, 0x54ffffc1, 0xaa0103e0, 0xd65f03c0] }]
  stubs := []
  exitAddr := 0

/-- Invariant at the loop body `L` (0x60008): `x0 = n > 0` iterations left, `x1 = 2·(N - n)`. -/
theorem loop_inv (N : Nat) (hN : N < 2 ^ 62) (ret : Nat) (hret : RetAddr loopp ret)
    (s : State) :
    ∀ n (S : State) (cnt acc : W64), 0 < n → n ≤ N → cnt.toNat = n → acc.toNat = 2 * (N - n) →
      S.pc = 0x60008#64 → S.regs 0 = cnt → S.regs 1 = acc → S.regs 30 = BitVec.ofNat 64 ret →
      S.sp = s.sp → S.regs 28 = s.regs 28 → S.regs 29 = s.regs 29 → S.regs 18 = s.regs 18 →
      Reaches (loopp.withExit ret) S
        (IsReturn fun s' => ABIReturn s s' ∧ (s'.regs 0).toNat = 2 * N) := by
  intro n
  induction n with
  | zero => intro _ _ _ h; omega
  | succ n ih =>
    intro S cnt acc _ hle hc hacc hpc h0 h1 h30 hsp h28 h29 h18
    janus_run until [0x60008]
    -- two goals: the last iteration falls through to `done` (arithmetic), or the loop goes
    -- around once more (the invariant at `L` again)
    all_goals first
      | omega
      | (apply ih _ (cnt - 1#64) (acc + 2#64) <;> (try janus_simp) <;> omega)

theorem loop_spec (x : W64) (hx : x.toNat < 2 ^ 62) :
    Ensures loopp 0x60000 [x] (fun _ => True)
      (fun _ s' => (s'.regs 0).toNat = 2 * x.toNat) := by
  intro ret hret s hs _
  janus_intro hs
  janus_run until [0x60008]
  -- `x = 0` goes straight to `done`; otherwise we are at the loop body with the invariant
  all_goals first
    | omega
    | exact loop_inv x.toNat hx ret hret s x.toNat _ x 0#64 (by omega)
        (Nat.le_refl _) rfl (by simp)
        (by janus_simp) (by janus_simp) (by janus_simp) (by janus_simp) (by janus_simp)
        (by janus_simp) (by janus_simp) (by janus_simp)

/-! ## Path merging (`janus.merge`)

`cmp x0, #10; b.hs 1f; add x1, x1, #1; 1: add x0, x0, x2; tst x2, #1; b.eq 2f; mov x3, #7;
b 3f; 2: mov x3, #9; cmp x3, #3; 3: add x0, x0, #4; ret`: two diamonds. The first rejoins with
`x1` written on one side only, the second with `x3` and the flags differing. With
`janus.merge` the paths are merged at each join (the differing registers become variables), so
a single goal reaches the return. -/

def diamondp : Program where
  segments := [{ name := "diamond", base := 0x70000, words := [0xf100281f, 0x54000042,
    0x91000421, 0x8b020000, 0xf240005f, 0x54000060, 0xd28000e3, 0x14000003, 0xd2800123,
    0xf1000c7f, 0x91001000, 0xd65f03c0] }]
  stubs := []
  exitAddr := 0

theorem diamond_spec (x y z : W64) :
    Ensures diamondp 0x70000 [x, y, z] (fun _ => True)
      (fun _ s' => s'.regs 0 = x + z + 4#64) := by
  intro ret hret s hs _
  janus_intro hs
  -- stop at the second join: the four paths arrive there as one goal (without merging, four
  -- goals would remain and the single `·` below would leave three unsolved)
  set_option janus.merge true in janus_run until [0x70028]
  · janus_run

end JanusTests.Tactic
