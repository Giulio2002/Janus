import Janus

/-!
# Tests for the symbolic-execution tactics (`Janus.Tactic`)

Each test is a small program (hand-assembled with `aarch64-linux-gnu-as`) and a theorem proved by
`janus_run`. Together they cover: straight-line code (50 instructions), the large extraction form
with one definition per segment (`seg<i>`, 6000 padding words), branches with a panic stub,
memory with aliasing, read-only data (`DataLoaded`), calls through a callee `Summary`, and a loop
proved by an invariant.
-/

namespace JanusTests.Tactic

open Janus Janus.Arm64 Janus.GoABI Janus.Tactic Janus.Spec

/-! ## Straight-line code: 51 instructions

`24 × (add x0, x0, x1; eor x2, x2, x0); sub x4, x0, x1; ret` -/

def straight : Program where
  segments := [{ name := "straight", base := 0x10000, words := [0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0x8b010000, 0xca000042, 0xcb010004, 0xd65f03c0] }]
  stubs := []
  exitAddr := 0

theorem straight_spec (x y : W64) :
    Ensures straight 0x10000 [x, y] (fun _ => True)
      (fun _ s' => (s'.regs 0).toNat = (x.toNat + 24 * y.toNat) % 2 ^ 64 ∧
        (s'.regs 4).toNat = (x.toNat + 23 * y.toNat) % 2 ^ 64) := by
  intro ret hret s hs _
  janus_intro hs
  janus_run
  all_goals janus_arith

/-! ## The large extraction form: one definition per segment

`janus extract` writes `def seg<i> : Segment` per segment when a program has more than 2048
words. The tactic evaluates the program once and the kernel checks each fetch, so the padding
segments cost nothing per step. -/

