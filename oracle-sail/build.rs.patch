+            };
+            // 1) the precompiled header (g++ looks for pch.h.gch next to pch.h)
+            {
+                let b = part_builder(false);
+                let tool = b.get_compiler();
+                let mut cmd = tool.to_command();
+                cmd.arg("-x").arg("c++-header").arg(pch_dir.join("pch.h")).arg("-o")
+                    .arg(pch_dir.join("pch.h.gch"));
+                let status = cmd.status().expect("run the C++ compiler for the precompiled header");
+                assert!(status.success(), "precompiling the model header failed");
+            }
+            // 2) all translation units on NUM_JOBS threads; objects in a fixed order
+            let mut jobs: Vec<(PathBuf, bool)> = parts.iter().map(|p| (p.clone(), true)).collect();
+            jobs.push((PathBuf::from("csrc/shim.cpp"), false));
+            let missing_p = model_inc.join("model_missing.cpp");
+            if missing_p.is_file() {
+                jobs.push((missing_p, false));
+            }
+            let nthreads = env::var("NUM_JOBS").ok().and_then(|v| v.parse::<usize>().ok()).unwrap_or(1).max(1);
+            let next = std::sync::atomic::AtomicUsize::new(0);
+            let results: std::sync::Mutex<Vec<Option<Vec<PathBuf>>>> =
+                std::sync::Mutex::new(vec![None; jobs.len()]);
+            let shim_like = |f: &Path| {
+                // shim.cpp and model_missing.cpp include model.h after other headers, so they cannot
