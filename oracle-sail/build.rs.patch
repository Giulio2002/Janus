+            // Janus: the model class header (one 40k-member class) takes g++ ~4 minutes to parse, and
+            // cc compiles files one after the other here (its `parallel` feature is off). So: precompile
+            // prefix header + model.h once, then compile the parts, shim.cpp and model_missing.cpp on
+            // NUM_JOBS threads, and archive the objects in a fixed order.
+            let mut parts: Vec<PathBuf> = std::fs::read_dir(dir)
+                .expect("read AARCH64_ORACLE_SAIL_MODEL_PARTS")
+                .map(|e| e.expect("dir entry").path())
+                .filter(|p| p.file_name().and_then(|n| n.to_str())
+                    .is_some_and(|n| n.starts_with("model_part_") && n.ends_with(".cpp")))
+                .collect();
+            parts.sort();
+            assert!(!parts.is_empty(), "no model_part_*.cpp in {dir:?}");
+            for p in &parts {
+                println!("cargo:rerun-if-changed={}", p.display());
+            }
+            let out = PathBuf::from(env::var("OUT_DIR").unwrap());
+            let pch_dir = out.join("pch");
+            let _ = std::fs::remove_dir_all(&pch_dir);
+            std::fs::create_dir_all(&pch_dir).expect("create pch dir");
+            // pch.h = the force-included prefix header, then the model header: exactly what every
+            // part sees first (the parts' own `#include "model.h"` is then a no-op).
+            std::fs::write(
+                pch_dir.join("pch.h"),
+                format!("#include \"{}\"\n#include \"model.h\"\n", prefix_header.display()),
+            )
+            .expect("write pch.h");
+            // The part builder: the same flags as `cxx` except that pch.h replaces the -include of
+            // the prefix header (a precompiled header must come before every other token).
+            let part_builder = |with_pch: bool| {
+                let mut b = cc::Build::new();
+                b.cpp(true)
+                    .std("c++20")
+                    .include(&sail_lib)
+                    .include(&model_inc)
+                    .include("csrc")
+                    .flag_if_supported("/bigobj");
+                b.opt_level_str(&model_opt);
+                if with_pch {
+                    b.flag("-include").flag(pch_dir.join("pch.h"));
+                    b.flag("-Winvalid-pch").flag("-Werror=invalid-pch");
+                }
+                b.flag_if_supported("-Wno-unused")
+                    .flag_if_supported("-Wno-unused-parameter")
+                    .flag_if_supported("-Wno-unused-but-set-variable")
+                    .flag_if_supported("-Wno-sign-compare")
+                    .flag_if_supported("-Wno-extra");
+                if system_gmp {
+                    b.define("SAIL_SYSTEM_GMP", None);
+                    if let Some(inc) = &gmp_include {
+                        b.include(inc);
+                    }
+                }
