theorem lit_case {w : Nat} (hw : w < 2 ^ 32) (h0 : (w / 2 ^ 27) % 8 = 3) (h1 : (w / 2 ^ 26) % 2 = 0)
    (h2 : (w / 2 ^ 24) % 4 = 0)
    {js js1 : Janus.Arm64.State} {s : SState} (h : Rel js s) (hm : MemRel js.mem s) (hc : LinuxEL0Config s)
    (hU : UserMapped js.mem s) {size opc sz : Nat} {k : Int} {sgn : Bool}
    (hcase : (size = 2 ∧ opc = 1 ∧ sz = 4 ∧ sgn = false) ∨ (size = 3 ∧ opc = 1 ∧ sz = 8 ∧ sgn = false) ∨
      (size = 2 ∧ opc = 2 ∧ sz = 4 ∧ sgn = true))
    (hchain : ∀ st : SState, st.regs.get? .SEE = some (-1) →
      (__DecodeA64_LoadStore (js.pc.toNat : Int) (BitVec.ofNat 32 w)).run st =
        (execute_aarch64_instrs_memory_literal_general .MemOp_LOAD false (sign_extend (fld w 5 19 +++ 0b00#2) 64)
          sgn sz (fld w 0 5).toNat false).run (st.set .SEE k))
    (hx : Janus.Arm64.memSingle js size opc (Janus.Arm64.bits w 4 0)
      (js.pc + Janus.Arm64.sext64 21 (Janus.Arm64.bits w 23 5 * 4)) = .ok js1) :
    ∃ s', (janus_step (BitVec.ofNat 32 w)).run s = .ok .Janus_OK s' ∧ Rel js1.next s' ∧ MemRel js1.next.mem s' ∧
      LinuxEL0Config s' := by
  have hrt : (fld w 0 5).toNat = Janus.Arm64.bits w 4 0 := (bits_eq_fld w 4 0 hw).symm
  have ht32 : Janus.Arm64.bits w 4 0 < 32 := by simp only [bits_def]; omega
  obtain ⟨hR, hM, hC, hT⟩ := entry_facts h hm hc w k
  have hdec : (__DecodeA64 (js.pc.toNat : Int) (BitVec.ofNat 32 w)).run (stepEntry s (BitVec.ofNat 32 w)) =
      (execute_aarch64_instrs_memory_literal_general .MemOp_LOAD false
        (Janus.Arm64.sext64 21 (Janus.Arm64.bits w 23 5 * 4)) sgn sz (Janus.Arm64.bits w 4 0) false).run
        (entrySt s w k) := by
    rw [run_DecodeA64_LS hw (by omega) (by omega) (by omega), hchain _ (see_entry s _), hrt, lit_offset hw]
  have hpc : js1.pc = js.pc := by
    obtain ⟨_, rfl⟩ := memSingle_load (by omega) hx
    unfold Janus.Arm64.State.writeZR; split <;> rfl
  obtain ⟨s2, hr2, hrel, hmem, hst⟩ := run_exec_lit hR hM hC hU hT hcase ht32 _ false hx
  obtain ⟨e1, e2, e3⟩ := step_agree_mem h hc (k := k) (hdec.trans hr2) hrel hst.regs hpc
  exact ⟨_, e1, e2, hmem, e3⟩

/-- **LDR (literal) and LDRSW (literal)**: for every word `opc 011 0 00 imm19 Rt` with `opc ≠ 11`
(not PRFM) and every related pair of states under `LinuxEL0Config` and `UserMapped`, whenever
Janus steps the word the generated ASL step completes in a related state, with Janus' memory
related to the ASL's. -/
theorem ldrLit_agree {w : Nat} (hw : w < 2 ^ 32) (h0 : (w / 2 ^ 27) % 8 = 3) (h1 : (w / 2 ^ 26) % 2 = 0)
    (h2 : (w / 2 ^ 24) % 4 = 0) (ho : (w / 2 ^ 30) % 4 ≠ 3)
    {js js' : Janus.Arm64.State} {s : SState} (h : Rel js s) (hm : MemRel js.mem s) (hc : LinuxEL0Config s)
    (hU : UserMapped js.mem s) (hj : Janus.Arm64.step w js = .ok js') :
    ∃ s', (janus_step (BitVec.ofNat 32 w)).run s = .ok .Janus_OK s' ∧ Rel js' s' ∧ MemRel js'.mem s' ∧
      LinuxEL0Config s' := by
  rw [Janus.Arm64.step_of_decode (decode_ldrLit hw h0 h1 h2 ho)] at hj
  simp only [Janus.Arm64.exec] at hj
  have hb : Janus.Arm64.bits w 31 30 = (w / 2 ^ 30) % 4 := by simp only [bits_def]
  have fo : ∀ o : Nat, (w / 2 ^ 30) % 4 = o → o < 4 → fld w 30 2 = BitVec.ofNat 2 o := fun o e _ =>
    BitVec.eq_of_toNat_eq (by rw [fld_toNat w 30 2 hw]; simp; omega)
  rcases (show (w / 2 ^ 30) % 4 = 0 ∨ (w / 2 ^ 30) % 4 = 1 ∨ (w / 2 ^ 30) % 4 = 2 by omega) with e | e | e <;>
  rw [hb, e] at hj <;> simp only [show (1 = 0) = False from by decide, show (2 = 0) = False from by decide,
    show (2 = 1) = False from by decide, ite_true, ite_false] at hj <;> split at hj <;> (try cases hj)
  · next js1 hx =>
    exact lit_case (k := 624) hw h0 h1 h2 h hm hc hU (Or.inl ⟨rfl, rfl, rfl, rfl⟩) (fun st hst => by
      rw [run_LS_lit_0 hw h0 h1 h2 e hst, fo 0 e (by decide)]; exact run_dec_lit_0 _ _ _) hx
  · next js1 hx =>
    exact lit_case (k := 624) hw h0 h1 h2 h hm hc hU (Or.inr (Or.inl ⟨rfl, rfl, rfl, rfl⟩)) (fun st hst => by
      rw [run_LS_lit_1 hw h0 h1 h2 e hst, fo 1 e (by decide)]; exact run_dec_lit_1 _ _ _) hx
  · next js1 hx =>
    exact lit_case (k := 625) hw h0 h1 h2 h hm hc hU (Or.inr (Or.inr ⟨rfl, rfl, rfl, rfl⟩)) (fun st hst => by
      rw [run_LS_lit_2 hw h0 h1 h2 e hst, fo 2 e (by decide)]; exact run_dec_lit_2 _ _ _) hx

end JanusASL.Proofs
