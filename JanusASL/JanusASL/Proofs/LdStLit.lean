theorem run_exec_lit {js js1 : Janus.Arm64.State} {s0 s : SState} (h : Rel js s) (hm : MemRel js.mem s)
    (hc : LinuxEL0Config s) (hU : UserMapped js.mem s0) (hf : TFrame js.mem s0 s) {size opc sz : Nat} {sgn : Bool}
    (hcase : (size = 2 ∧ opc = 1 ∧ sz = 4 ∧ sgn = false) ∨ (size = 3 ∧ opc = 1 ∧ sz = 8 ∧ sgn = false) ∨
      (size = 2 ∧ opc = 2 ∧ sz = 4 ∧ sgn = true))
    {rt : Nat} (ht : rt < 32) (off : BitVec 64) (tc : Bool)
    (hj : Janus.Arm64.memSingle js size opc rt (js.pc + off) = .ok js1) :
    ∃ s', (execute_aarch64_instrs_memory_literal_general .MemOp_LOAD false off sgn sz rt tc).run s = .ok () s' ∧
      Rel js1 s' ∧ MemRel js1.mem s' ∧ RStep s s' := by
  obtain ⟨p, hp, he, _, hsp⟩ := hc.pstate
  have hcr := run_CreateAccDescGPR hc false tc
  simp only [Bool.false_eq_true, ite_false] at hcr
  rcases hcase with ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩ | ⟨rfl, rfl, rfl, rfl⟩
  · obtain ⟨hacc, rfl⟩ := memSingle_load (by decide) hj
    obtain ⟨v, hv, hvn⟩ := run_Mem_read hU hf hc hm (js.pc + off) 4 (by decide) hacc tc
    unfold execute_aarch64_instrs_memory_literal_general
    obtain ⟨s1, hx1, hr1, hst1⟩ := run_X_set_r h ht (N := 32) (by decide) v
    have hval : v.setWidth 64 = loadVal 2 1 (js.mem.readLE (js.pc + off).toNat (2 ^ 2)) := by
      apply BitVec.eq_of_toNat_eq
      have := v.isLt
      simp only [BitVec.toNat_setWidth, loadVal, ite_true, BitVec.toNat_ofNat, ← hvn]
      try rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)]
    simp only [Janus.Arm64.State.setX, hval] at hr1
    refine ⟨s1, ?_, hr1, ?_, hst1⟩
    · cfg_simp [PC_read, run_readReg h.pc, run_readReg hp, he, EL0, hcr, hv, hx1,
        run_readReg (hc.rstep hst1).speInFlight]
    · rw [writeZR_mem]; exact hm.rstep hst1
  · obtain ⟨hacc, rfl⟩ := memSingle_load (by decide) hj
    obtain ⟨v, hv, hvn⟩ := run_Mem_read hU hf hc hm (js.pc + off) 8 (by decide) hacc tc
    unfold execute_aarch64_instrs_memory_literal_general
    obtain ⟨s1, hx1, hr1, hst1⟩ := run_X_set_r h ht (N := 64) (by decide) v
    have hval : v.setWidth 64 = loadVal 3 1 (js.mem.readLE (js.pc + off).toNat (2 ^ 3)) := by
      apply BitVec.eq_of_toNat_eq
      have := v.isLt
      simp only [BitVec.toNat_setWidth, loadVal, ite_true, BitVec.toNat_ofNat, ← hvn]
      try rw [Nat.mod_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega)]
    simp only [Janus.Arm64.State.setX, hval] at hr1
    refine ⟨s1, ?_, hr1, ?_, hst1⟩
    · cfg_simp [PC_read, run_readReg h.pc, run_readReg hp, he, EL0, hcr, hv, hx1,
        run_readReg (hc.rstep hst1).speInFlight]
    · rw [writeZR_mem]; exact hm.rstep hst1
  · obtain ⟨hacc, rfl⟩ := memSingle_load (by decide) hj
    obtain ⟨v, hv, hvn⟩ := run_Mem_read hU hf hc hm (js.pc + off) 4 (by decide) hacc tc
    unfold execute_aarch64_instrs_memory_literal_general
    obtain ⟨s1, hx1, hr1, hst1⟩ := run_X_set_r h ht (N := 64) (Or.inr rfl) (sign_extend v 64)
    have hval : (sign_extend v 64).setWidth 64 = loadVal 2 2 (js.mem.readLE (js.pc + off).toNat (2 ^ 2)) := by
      have e : BitVec.ofNat 32 (js.mem.readLE (js.pc + off).toNat (2 ^ 2)) = v :=
        BitVec.eq_of_toNat_eq (by rw [show (2 : Nat) ^ 2 = 4 from rfl, ← hvn]; simp)
      simp only [loadVal, Janus.Arm64.signExtendLoad, show ¬ (2 = 1) from by decide, show 2 = 2 from rfl, ite_true,
        ite_false, show ¬ (2 = 0) from by decide, e]
      rfl
    simp only [Janus.Arm64.State.setX, hval] at hr1
    refine ⟨s1, ?_, hr1, ?_, hst1⟩
    · cfg_simp [PC_read, run_readReg h.pc, run_readReg hp, he, EL0, hcr, hv, hx1,
        run_readReg (hc.rstep hst1).speInFlight]
    · rw [writeZR_mem]; exact hm.rstep hst1

