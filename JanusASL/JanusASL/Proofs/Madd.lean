theorem run_decode_msub_madd (Rd Rn Ra : BitVec 5) (o0 : BitVec 1) (Rm : BitVec 5) (sf : BitVec 1) (s : SState) :
    (decode_msub_aarch64_instrs_integer_arithmetic_mul_uniform_add_sub Rd Rn Ra o0 Rm sf).run s =
      (execute_aarch64_instrs_integer_arithmetic_mul_uniform_add_sub Ra.toNat Rd.toNat (if sf == 1#1 then 64 else 32)
        (if sf == 1#1 then 64 else 32) Rm.toNat Rn.toNat (o0 == 1#1)).run s := by
  unfold decode_msub_aarch64_instrs_integer_arithmetic_mul_uniform_add_sub
  rfl

set_option maxHeartbeats 4000000 in
theorem run_execute_madd {js : Janus.Arm64.State} {s : SState} (h : Rel js s) {N : Nat}
    (hN : N = 32 ∨ N = 64) {a d m n : Nat} (ha : a < 32) (hd : d < 32) (hm : m < 32) (hn : n < 32) (sub : Bool) :
    ∃ s', (execute_aarch64_instrs_integer_arithmetic_mul_uniform_add_sub a d N N m n sub).run s = .ok () s' ∧
      Rel (Janus.Arm64.execMadd N js sub m a n d) s' ∧ Frame s s' := by
  have hN0 : 0 < N := by omega
  obtain ⟨s', hs', hr, hf⟩ := run_X_set_rel h hd hN
    (if sub then js.getX N a - js.getX N n * js.getX N m else js.getX N a + js.getX N n * js.getX N m)
  refine ⟨s', ?_, hr, hf⟩
  simp only [execute_aarch64_instrs_integer_arithmetic_mul_uniform_add_sub, run_bind, run_X_read_rel h hn hN,
    run_X_read_rel h hm hN, run_X_read_rel h ha hN, run_undefined_int, run_pure]
  rw [madd_eq hN0]
  exact hs'

set_option maxHeartbeats 8000000 in
theorem asl_madd {w : Nat} (hw : w < 2 ^ 32) (h1 : (w / 2 ^ 21) % 1024 = 0b0011011000)
    {js : Janus.Arm64.State} {s : SState} (h : Rel js s) (pc : Int) :
    ∃ s2, (__DecodeA64 pc (BitVec.ofNat 32 w)).run (stepEntry s (BitVec.ofNat 32 w)) = .ok () s2 ∧
      Rel (Janus.Arm64.execMadd (if fld w 31 1 == 1#1 then 64 else 32) js (fld w 15 1 == 1#1)
        (fld w 16 5).toNat (fld w 10 5).toNat (fld w 5 5).toNat (fld w 0 5).toNat) s2 ∧
      s2.regs.get? .__BranchTaken = some false := by
  rw [run_DecodeA64_DPReg hw (by omega)]
  rcases (show (w / 2 ^ 15) % 2 = 0 ∨ (w / 2 ^ 15) % 2 = 1 by omega) with hk | hk
  · rw [run_DataProcReg_madd_0 hw h1 hk (see_entry _ _), run_decode_madd_madd]
    obtain ⟨s2, hrun, hrel, hfr⟩ := run_execute_madd (h.entry (BitVec.ofNat 32 w) 690) (width_cases w)
      (fld_lt w 10 5) (fld_lt w 0 5) (fld_lt w 16 5) (fld_lt w 5 5) (fld w 15 1 == 1#1)
    exact ⟨s2, hrun, hrel, bt_after _ _ hfr⟩
  · rw [run_DataProcReg_madd_1 hw h1 hk (see_entry _ _), run_decode_msub_madd]
    obtain ⟨s2, hrun, hrel, hfr⟩ := run_execute_madd (h.entry (BitVec.ofNat 32 w) 691) (width_cases w)
      (fld_lt w 10 5) (fld_lt w 0 5) (fld_lt w 16 5) (fld_lt w 5 5) (fld w 15 1 == 1#1)
    exact ⟨s2, hrun, hrel, bt_after _ _ hfr⟩

/-- **MADD/MSUB**: for every word of the encoding class and every related pair of states, Janus'
`step` and the generated ASL agree. -/
theorem madd_agree {w : Nat} (hw : w < 2 ^ 32) (h1 : (w / 2 ^ 21) % 1024 = 0b0011011000)
    {js : Janus.Arm64.State} {s : SState} (h : Rel js s) :
    ∃ js' s', Janus.Arm64.step w js = .ok js' ∧
      (janus_step (BitVec.ofNat 32 w)).run s = .ok .Janus_OK s' ∧ Rel js' s' := by
  let F : Nat → Janus.Arm64.State := fun N => Janus.Arm64.execMadd N js (fld w 15 1 == 1#1)
    (fld w 16 5).toNat (fld w 10 5).toNat (fld w 5 5).toNat (fld w 0 5).toNat
  have hspec : ∀ N, (F N).pc = js.pc := by
    intro N; simp [F, Janus.Arm64.execMadd, Janus.Arm64.State.setX, Janus.Arm64.State.writeZR]; split <;> rfl
  obtain ⟨s2, hrun, hrel, hbt⟩ := asl_madd hw h1 h (js.pc.toNat : Int)
  have e : F (if fld w 31 1 == 1#1 then 64 else 32) = if fld w 31 1 == 1#1 then F 64 else F 32 := by
    split <;> rfl
  have hrel' : Rel (if fld w 31 1 == 1#1 then F 64 else F 32) s2 := e ▸ hrel
  refine step_agree h ⟨s2, hrun, hrel', hbt⟩ (by split <;> exact hspec _) ?_
  rw [Janus.Arm64.step_of_decode (decode_madd_class hw h1)]
  simp only [Janus.Arm64.exec, ← fld_bit w 31 hw, ← fld_bit w 15 hw,
    bits_eq_fld w 20 16 hw, bits_eq_fld w 14 10 hw, bits_eq_fld w 9 5 hw, bits_eq_fld w 4 0 hw]
  split <;> simp_all [Janus.Arm64.State.next, F]

