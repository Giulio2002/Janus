#!/usr/bin/env bash
# Serialises the `lake` invocations of the gate lanes that share one isolated source tree (scripts/gate.sh).
# Any lake call in a package under $JANUS_LANE_TREE takes a flock on $JANUS_LANE_LAKE_LOCK: EXCLUSIVE for every
# command that can build or rewrite the package (build, update, exe, clean, cache, ... anything but `env` and
# `--version`/`--help`), SHARED for `lake env` (read-only use of the built package, e.g. `lake env lean F`,
# `lake env leanchecker M`). A rewrite (dependency re-resolution, "URL has changed; deleting packages/Sail and
# cloning", a rebuild) therefore never overlaps another lake call of the tree, while read-only lanes still run
# side by side. Calls outside the tree, or without the variables, pass through. JANUS_REAL_LAKE is the real lake.
real="${JANUS_REAL_LAKE:?lanelake: JANUS_REAL_LAKE is not set}"
tree="${JANUS_LANE_TREE:-}"; enabled="${JANUS_LANE_LAKE_LOCK:-}"
here="$(pwd -P)"
d="$(dirname "${BASH_SOURCE[0]}")"
. "$d/keys.sh"
if [ -n "$tree" ] && [ -n "$enabled" ]; then
  case "$here/" in
    "$tree"/*)
      pkg="$(lane_pkg_dir "$here")"
      lock="$(lane_lake_lock "$pkg")"   # keyed by the RESOLVED .lake of the package: trees sharing it by symlink share the lock
      # the caller already holds this lock exclusively (scripts/asl.sh tl_run: a write phase runs under it): do not take it
      # again (flock is not re-entrant across file descriptors)
      [ "${JANUS_LANE_LOCK_HELD:-}" = "$lock" ] && exec "$real" "$@"
      mode=-x
      case "${1:-}" in env|--version|--help|-h|-v|"") mode=-s ;; esac
      # An exclusive call also takes the JANUS FRAMEWORK lock (the real <tree>/.lake/janus-framework.lock, the one a
      # `janus ... --janus-root <tree>` holds shared for a whole verification): lake here replays and rewrites
      # Janus/*.olean in the tree's framework build, and a running janus must not see that.
      # LOCK ORDER (one total order, no cycle): the packages other than the tree's own (JanusASL, ...) < the framework lock
      # < the tree's own package lock. janus takes the framework lock and, while it BUILDS the framework (exclusive), runs
      # `lake build` in the tree root, i.e. fw -> root package; so a lake call at the tree root takes the framework lock
      # first and the package lock second, and a call in another package takes its package lock first.
      # janus runs this lake as its own child while it holds the framework lock EXCLUSIVELY and says so in
      # JANUS_FRAMEWORK_LOCK_HELD_X (the lock path): that lock is already ours, not taken again (flock is not re-entrant
      # across descriptors: it was a self-deadlock). Only an exclusive hold of exactly this lock counts.
      if [ "$mode" = -x ] && [ -d "$tree/.lake" ]; then
        fw="$(lane_fw_lock "$tree")"
        if [ -n "${JANUS_FRAMEWORK_LOCK_HELD_X:-}" ] && [ "$(realpath -m "$JANUS_FRAMEWORK_LOCK_HELD_X")" = "$fw" ]; then
          exec python3 -I "$d/lockexec.py" x "$lock" "$real" "$@"
        fi
        if [ "$pkg" = "$(cd "$tree" && pwd -P)" ]; then
          exec python3 -I "$d/lockexec.py" x "$fw" "+x:$lock" "$real" "$@"
        fi
        exec python3 -I "$d/lockexec.py" x "$lock" "+x:$fw" "$real" "$@"
      fi
      exec python3 -I "$d/lockexec.py" "${mode#-}" "$lock" "$real" "$@" ;;
  esac
fi
exec "$real" "$@"
